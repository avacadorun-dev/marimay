# Canonical source, generated templates and documentation use LF on every host.
* text=auto eol=lf

# Fixtures and fuzz corpora are byte contracts, including intentional CRLF,
# malformed encodings and binary bundles. Never translate their committed bytes.
tests/** -text

# Dependency patch digest is defined over its committed LF bytes.
cmake/sljit-arm64-minimum.patch text eol=lf
