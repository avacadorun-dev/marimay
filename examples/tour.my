import { Error as IoError, println } from "std/io";

enum LookupError {
  NotFound { id: int, },
  Denied { reason: string, },
}

enum AppError {
  Lookup(LookupError),
  Io(IoError),
}

fn message(error: LookupError): string {
  return match error {
    NotFound { id } => $"user {id} was not found",
    Denied { reason } => $"access denied: {reason}",
  };
}

fn message(error: AppError): string {
  return match error {
    Lookup(inner) => inner.message(),
    Io(inner) => inner.message(),
  };
}

fn lookupError(error: LookupError): AppError {
  return AppError.Lookup(error);
}

fn ioError(error: IoError): AppError {
  return AppError.Io(error);
}

@derive(Debug)
type User {
  public id: int,
  public name: string,
  public mutable visits: int,
}

interface Stringer {
  string(): string;
}

fn string(user: User): string {
  return $"{user.name} (#{user.id}, visits: {user.visits})";
}

fn visit(user: User): void {
  user.visits += 1;
}

fn interpolate(left: f64, right: f64, weight: f64): f64 {
  return left + ((right - left) * weight);
}

fn printValue(value: Stringer): Result<void, IoError> {
  return println(value.string());
}

fn findUser(id: int): Result<User, LookupError> {
  if id != 7 {
    return Err(LookupError.NotFound { id });
  }
  return Ok(User { id, name: "Mara", visits: 0 });
}

fn main(): Result<void, AppError> {
  const user = findUser(7).mapError(lookupError)?;
  user.visit();
  printValue(user).mapError(ioError)?;
  // Dot call and ordinary call resolve to the same function.
  println(string(user)).mapError(ioError)?;
  return Ok();
}
