type Stack {
  values: Array<int>;
  mutable size: int;
}

fn push(stack: Stack, value: int): void {
  stack.values.push(value);
  stack.size += 1;
}

fn length(stack: Stack): int {
  return stack.size;
}

fn receiverCollectionNamesWork(): bool {
  const stack = Stack { values: [], size: 0 };
  push(stack, 7);
  stack.push(9);
  const values = [1];
  push(values, 2);
  values.push(3);
  return length(stack) == 2 && stack.length() == 2 && length(values) == 3 && values.length() == 3;
}
