fn consumeLast(rows: [][]int): Option<[]int> {
  return rows.pop();
}

fn prepare(values: []int): Result<bool, ArrayGrowthError> {
  values.reserve(16)?;
  values.push(7)?;
  return Ok(true);
}

fn arrayMutationExample(): bool {
  let values = [1, 2, 3];
  const last = values.pop();
  const _ = values.truncate(1);
  const _ = values.clear();
  return match last {
    Some(value) => value == 3
      && values.length() == 0,
      None => false,
    };
}
