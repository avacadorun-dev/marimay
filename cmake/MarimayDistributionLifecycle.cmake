cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED MMAY_DISTRIBUTION_ACTION
    OR NOT DEFINED MMAY_DISTRIBUTION_PREFIX)
  message(FATAL_ERROR
    "MMAY_DISTRIBUTION_ACTION and MMAY_DISTRIBUTION_PREFIX are required")
endif()

cmake_path(ABSOLUTE_PATH MMAY_DISTRIBUTION_PREFIX NORMALIZE
  OUTPUT_VARIABLE mmay_prefix)
if(mmay_prefix STREQUAL "/" OR mmay_prefix MATCHES "^[A-Za-z]:/$")
  message(FATAL_ERROR "refusing a filesystem-root distribution prefix")
endif()

set(mmay_stage "${mmay_prefix}.mmay-stage")
set(mmay_backup "${mmay_prefix}.mmay-backup")

function(mmay_distribution_manifest root output_manifest output_paths)
  file(GLOB manifests LIST_DIRECTORIES false
    "${root}/share/mmay/*/checksums.sha256")
  list(LENGTH manifests manifest_count)
  if(NOT manifest_count EQUAL 1)
    message(FATAL_ERROR
      "distribution must contain exactly one checksum manifest: ${root}")
  endif()
  list(GET manifests 0 manifest)
  file(STRINGS "${manifest}" lines ENCODING UTF-8)
  set(paths "")
  foreach(line IN LISTS lines)
    if(NOT line MATCHES "^([0-9a-f]+)  (.+)$")
      message(FATAL_ERROR "malformed distribution checksum line")
    endif()
    set(expected "${CMAKE_MATCH_1}")
    set(relative "${CMAKE_MATCH_2}")
    string(LENGTH "${expected}" expected_length)
    if(NOT expected_length EQUAL 64)
      message(FATAL_ERROR "malformed distribution checksum digest")
    endif()
    if(relative MATCHES "(^/|^\\.\\./|/\\.\\./)")
      message(FATAL_ERROR "unsafe distribution checksum path: ${relative}")
    endif()
    if(NOT EXISTS "${root}/${relative}"
        OR IS_DIRECTORY "${root}/${relative}")
      message(FATAL_ERROR "distribution file is missing: ${relative}")
    endif()
    file(SHA256 "${root}/${relative}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "distribution checksum mismatch: ${relative}")
    endif()
    list(APPEND paths "${relative}")
  endforeach()
  if(NOT paths)
    message(FATAL_ERROR "distribution checksum manifest is empty")
  endif()
  set(${output_manifest} "${manifest}" PARENT_SCOPE)
  set(${output_paths} "${paths}" PARENT_SCOPE)
endfunction()

function(mmay_distribution_prune_empty root paths)
  set(directories "${root}")
  foreach(relative IN LISTS paths)
    get_filename_component(parent "${relative}" DIRECTORY)
    while(NOT parent STREQUAL "" AND NOT parent STREQUAL ".")
      list(APPEND directories "${root}/${parent}")
      get_filename_component(parent "${parent}" DIRECTORY)
    endwhile()
  endforeach()
  list(REMOVE_DUPLICATES directories)
  list(SORT directories COMPARE STRING ORDER DESCENDING)
  foreach(pass RANGE 0 31)
    foreach(directory IN LISTS directories)
      if(IS_DIRECTORY "${directory}")
        file(GLOB children LIST_DIRECTORIES true "${directory}/*")
        if(NOT children)
          file(REMOVE_RECURSE "${directory}")
        endif()
      endif()
    endforeach()
  endforeach()
endfunction()

if((EXISTS "${mmay_backup}" OR IS_SYMLINK "${mmay_backup}")
    AND NOT EXISTS "${mmay_prefix}" AND NOT IS_SYMLINK "${mmay_prefix}")
  file(RENAME "${mmay_backup}" "${mmay_prefix}" RESULT recovery_result)
  if(NOT recovery_result STREQUAL "0")
    message(FATAL_ERROR "cannot recover interrupted distribution upgrade")
  endif()
  message(FATAL_ERROR
    "recovered an interrupted upgrade; inspect the prefix before retrying")
elseif(EXISTS "${mmay_backup}" OR IS_SYMLINK "${mmay_backup}")
  message(FATAL_ERROR "stale distribution backup requires inspection")
endif()

if(MMAY_DISTRIBUTION_ACTION STREQUAL "uninstall")
  if(NOT IS_DIRECTORY "${mmay_prefix}" OR IS_SYMLINK "${mmay_prefix}")
    message(FATAL_ERROR "distribution prefix is not installed")
  endif()
  mmay_distribution_manifest(
    "${mmay_prefix}" mmay_manifest mmay_owned_paths)
  foreach(relative IN LISTS mmay_owned_paths)
    file(REMOVE "${mmay_prefix}/${relative}")
  endforeach()
  file(REMOVE "${mmay_manifest}")
  list(APPEND mmay_owned_paths
    "share/mmay/checksums.sha256-placeholder")
  mmay_distribution_prune_empty("${mmay_prefix}" "${mmay_owned_paths}")
  message(STATUS "uninstalled Marimay files from ${mmay_prefix}")
  return()
endif()

if(NOT MMAY_DISTRIBUTION_ACTION STREQUAL "install"
    AND NOT MMAY_DISTRIBUTION_ACTION STREQUAL "upgrade")
  message(FATAL_ERROR "action must be install, upgrade, or uninstall")
endif()
if(NOT DEFINED MMAY_DISTRIBUTION_SOURCE
    OR NOT IS_DIRECTORY "${MMAY_DISTRIBUTION_SOURCE}")
  message(FATAL_ERROR "MMAY_DISTRIBUTION_SOURCE must be an extracted tree")
endif()
if(EXISTS "${mmay_stage}" OR IS_SYMLINK "${mmay_stage}")
  message(FATAL_ERROR "stale distribution stage requires inspection")
endif()

cmake_path(ABSOLUTE_PATH MMAY_DISTRIBUTION_SOURCE NORMALIZE
  OUTPUT_VARIABLE mmay_source)
mmay_distribution_manifest("${mmay_source}" unused_manifest source_paths)

if(MMAY_DISTRIBUTION_ACTION STREQUAL "install")
  if(EXISTS "${mmay_prefix}" OR IS_SYMLINK "${mmay_prefix}")
    message(FATAL_ERROR "install prefix already exists")
  endif()
elseif(NOT IS_DIRECTORY "${mmay_prefix}" OR IS_SYMLINK "${mmay_prefix}")
  message(FATAL_ERROR "upgrade prefix is not an installed directory")
endif()

file(MAKE_DIRECTORY "${mmay_stage}")
file(COPY "${mmay_source}/" DESTINATION "${mmay_stage}")
mmay_distribution_manifest("${mmay_stage}" staged_manifest staged_paths)

if(MMAY_DISTRIBUTION_ACTION STREQUAL "upgrade")
  mmay_distribution_manifest(
    "${mmay_prefix}" installed_manifest installed_paths)
  set(installed_owned_directories "")
  foreach(owned_path IN LISTS installed_paths)
    get_filename_component(owned_parent "${owned_path}" DIRECTORY)
    while(NOT owned_parent STREQUAL "" AND NOT owned_parent STREQUAL ".")
      list(APPEND installed_owned_directories "${owned_parent}")
      get_filename_component(owned_parent "${owned_parent}" DIRECTORY)
    endwhile()
  endforeach()
  list(REMOVE_DUPLICATES installed_owned_directories)
  file(GLOB_RECURSE installed_files LIST_DIRECTORIES true
    "${mmay_prefix}/*")
  foreach(installed_file IN LISTS installed_files)
    file(RELATIVE_PATH relative "${mmay_prefix}" "${installed_file}")
    list(FIND installed_paths "${relative}" owned_index)
    list(FIND installed_owned_directories "${relative}" owned_directory_index)
    if(IS_SYMLINK "${installed_file}" AND owned_index EQUAL -1)
      if(EXISTS "${mmay_stage}/${relative}")
        file(REMOVE_RECURSE "${mmay_stage}")
        message(FATAL_ERROR
          "new distribution collides with unrelated prefix link: ${relative}")
      endif()
      get_filename_component(stage_parent "${mmay_stage}/${relative}" DIRECTORY)
      file(MAKE_DIRECTORY "${stage_parent}")
      file(READ_SYMLINK "${installed_file}" link_target)
      file(CREATE_LINK "${link_target}" "${mmay_stage}/${relative}" SYMBOLIC)
    elseif(IS_DIRECTORY "${installed_file}")
      if(owned_directory_index EQUAL -1)
        file(MAKE_DIRECTORY "${mmay_stage}/${relative}")
      endif()
    elseif(owned_index EQUAL -1
        AND NOT installed_file STREQUAL installed_manifest)
      if(EXISTS "${mmay_stage}/${relative}")
        file(REMOVE_RECURSE "${mmay_stage}")
        message(FATAL_ERROR
          "new distribution collides with unrelated prefix file: ${relative}")
      endif()
      get_filename_component(stage_parent "${mmay_stage}/${relative}" DIRECTORY)
      file(MAKE_DIRECTORY "${stage_parent}")
      file(COPY_FILE "${installed_file}" "${mmay_stage}/${relative}")
    endif()
  endforeach()
  file(RENAME "${mmay_prefix}" "${mmay_backup}" RESULT backup_result)
  if(NOT backup_result STREQUAL "0")
    file(REMOVE_RECURSE "${mmay_stage}")
    message(FATAL_ERROR "cannot stage existing distribution for upgrade")
  endif()
  file(RENAME "${mmay_stage}" "${mmay_prefix}" RESULT publish_result)
  if(NOT publish_result STREQUAL "0")
    file(RENAME "${mmay_backup}" "${mmay_prefix}" RESULT restore_result)
    if(NOT restore_result STREQUAL "0")
      message(FATAL_ERROR "upgrade publication and recovery both failed")
    endif()
    message(FATAL_ERROR "upgrade publication failed; previous tree restored")
  endif()
  file(REMOVE_RECURSE "${mmay_backup}")
  message(STATUS "upgraded Marimay distribution at ${mmay_prefix}")
else()
  if(EXISTS "${mmay_prefix}" OR IS_SYMLINK "${mmay_prefix}")
    file(REMOVE_RECURSE "${mmay_stage}")
    message(FATAL_ERROR "install prefix appeared before publication")
  endif()
  file(RENAME "${mmay_stage}" "${mmay_prefix}" RESULT publish_result)
  if(NOT publish_result STREQUAL "0")
    file(REMOVE_RECURSE "${mmay_stage}")
    message(FATAL_ERROR "clean install publication failed")
  endif()
  message(STATUS "installed Marimay distribution at ${mmay_prefix}")
endif()
