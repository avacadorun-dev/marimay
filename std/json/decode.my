import * as bytes from "std/bytes";
import * as convert from "std/convert";

fn decoderLength(decoder: Decoder): int {
  return bytes.length(decoder.input);
}

fn peek(decoder: Decoder): int {
  if decoder.offset == decoderLength(decoder) {
    return -1;
  }
  return bytes.get(decoder.input, decoder.offset) as int;
}

fn whitespace(value: int): bool {
  return value == 32 || value == 9 || value == 10 || value == 13;
}

fn skipWhitespace(decoder: Decoder): void {
  while whitespace(peek(decoder)) {
    decoder.offset += 1;
  }
}

fn unexpected(decoder: Decoder, expected: string): Error {
  const length = decoderLength(decoder);
  if decoder.offset == length {
    return Error.UnexpectedEnd { path: [], expected, span: emptySpan(length) };
  }
  return Error.UnexpectedToken { path: [], expected, span: byteSpan(decoder.offset, length) };
}

fn limitError(resource: string, limit: int, start: int, end: int): Error {
  return Error.LimitExceeded { path: [], resource, limit, span: Span { start, end } };
}

fn appendDecodedByte(
  decoder: Decoder,
  builder: bytes.Builder,
  value: byte,
  sourceOffset: int,
): Result<void, Error> {
  return match bytes.appendByte(builder, value) {
    Ok(_) => Ok(),
    Err(_) => Err(
      limitError("string bytes", decoder.limits.stringBytes, sourceOffset, sourceOffset + 1),
    ),
  };
}

fn narrowByte(value: int): byte {
  return match tryConvert<byte>(value) {
    Some(result) => result,
    None => panic("std/json internal byte conversion"),
  };
}

fn hexDigit(value: int): int {
  if value >= 48 && value <= 57 {
    return value - 48;
  }
  if value >= 65 && value <= 70 {
    return value - 65 + 10;
  }
  if value >= 97 && value <= 102 {
    return value - 97 + 10;
  }
  return -1;
}

fn readHex4(decoder: Decoder, escapeStart: int): Result<int, Error> {
  if decoderLength(decoder) - decoder.offset < 4 {
    return Err(
      Error.InvalidUnicodeEscape {
        path: [],
        span: Span { start: escapeStart, end: decoderLength(decoder) },
      },
    );
  }
  let value = 0;
  for index in 0..4 {
    const digit = hexDigit(bytes.get(decoder.input, decoder.offset + index) as int);
    if digit < 0 {
      return Err(
        Error.InvalidUnicodeEscape {
          path: [],
          span: Span { start: decoder.offset + index, end: decoder.offset + index + 1 },
        },
      );
    }
    value = value * 16 + digit;
  }
  decoder.offset += 4;
  return Ok(value);
}

fn appendScalar(
  decoder: Decoder,
  builder: bytes.Builder,
  scalar: int,
  sourceOffset: int,
): Result<void, Error> {
  if scalar <= 127 {
    return appendDecodedByte(decoder, builder, narrowByte(scalar), sourceOffset);
  }
  if scalar <= 2047 {
    appendDecodedByte(decoder, builder, narrowByte(192 + scalar / 64), sourceOffset)?;
    return appendDecodedByte(decoder, builder, narrowByte(128 + scalar % 64), sourceOffset);
  }
  if scalar <= 65535 {
    appendDecodedByte(decoder, builder, narrowByte(224 + scalar / 4096), sourceOffset)?;
    appendDecodedByte(decoder, builder, narrowByte(128 + scalar / 64 % 64), sourceOffset)?;
    return appendDecodedByte(decoder, builder, narrowByte(128 + scalar % 64), sourceOffset);
  }
  appendDecodedByte(decoder, builder, narrowByte(240 + scalar / 262144), sourceOffset)?;
  appendDecodedByte(decoder, builder, narrowByte(128 + scalar / 4096 % 64), sourceOffset)?;
  appendDecodedByte(decoder, builder, narrowByte(128 + scalar / 64 % 64), sourceOffset)?;
  return appendDecodedByte(decoder, builder, narrowByte(128 + scalar % 64), sourceOffset);
}

fn decodeUnicodeEscape(
  decoder: Decoder,
  builder: bytes.Builder,
  escapeStart: int,
): Result<void, Error> {
  let scalar = readHex4(decoder, escapeStart)?;
  if scalar >= 55296 && scalar <= 56319 {
    if decoderLength(decoder) - decoder.offset < 6
      || bytes.get(decoder.input, decoder.offset) as int != 92
      || bytes.get(decoder.input, decoder.offset + 1) as int != 117 {
      return Err(
        Error.InvalidUnicodeEscape {
          path: [],
          span: Span { start: escapeStart, end: decoder.offset },
        },
      );
    }
    decoder.offset += 2;
    const lowStart = decoder.offset - 2;
    const low = readHex4(decoder, lowStart)?;
    if low < 56320 || low > 57343 {
      return Err(
        Error.InvalidUnicodeEscape {
          path: [],
          span: Span { start: lowStart, end: decoder.offset },
        },
      );
    }
    scalar = 65536 + (scalar - 55296) * 1024 + low - 56320;
  } else if scalar >= 56320 && scalar <= 57343 {
    return Err(
      Error.InvalidUnicodeEscape {
        path: [],
        span: Span { start: escapeStart, end: decoder.offset },
      },
    );
  }
  return appendScalar(decoder, builder, scalar, escapeStart);
}

fn decodeEscape(decoder: Decoder, builder: bytes.Builder, escapeStart: int): Result<void, Error> {
  if decoder.offset == decoderLength(decoder) {
    return Err(
      Error.InvalidEscape { path: [], span: Span { start: escapeStart, end: decoder.offset } },
    );
  }
  const value = bytes.get(decoder.input, decoder.offset) as int;
  decoder.offset += 1;
  if value == 34 || value == 47 || value == 92 {
    return appendDecodedByte(decoder, builder, narrowByte(value), escapeStart);
  }
  if value == 98 {
    return appendDecodedByte(decoder, builder, 8, escapeStart);
  }
  if value == 102 {
    return appendDecodedByte(decoder, builder, 12, escapeStart);
  }
  if value == 110 {
    return appendDecodedByte(decoder, builder, 10, escapeStart);
  }
  if value == 114 {
    return appendDecodedByte(decoder, builder, 13, escapeStart);
  }
  if value == 116 {
    return appendDecodedByte(decoder, builder, 9, escapeStart);
  }
  if value == 117 {
    return decodeUnicodeEscape(decoder, builder, escapeStart);
  }
  return Err(
    Error.InvalidEscape { path: [], span: Span { start: escapeStart, end: decoder.offset } },
  );
}

fn parseString(decoder: Decoder): Result<string, Error> {
  skipWhitespace(decoder);
  if peek(decoder) != 34 {
    return Err(unexpected(decoder, "a JSON string"));
  }
  const stringStart = decoder.offset;
  decoder.offset += 1;
  const builder = match bytes.newBuilder(decoder.limits.stringBytes) {
    Ok(value) => value,
    Err(_) => panic("std/json validated string limit"),
  };
  while decoder.offset < decoderLength(decoder) {
    const sourceOffset = decoder.offset;
    const value = bytes.get(decoder.input, decoder.offset) as int;
    decoder.offset += 1;
    if value == 34 {
      return match bytes.decodeUtf8(bytes.finish(builder)) {
        Ok(text) => Ok(text),
        Err(_) => panic("std/json input and escape UTF-8 validation diverged"),
      };
    }
    if value < 32 {
      return Err(
        Error.UnexpectedToken {
          path: [],
          expected: "an escaped control character",
          span: Span { start: sourceOffset, end: sourceOffset + 1 },
        },
      );
    }
    if value == 92 {
      decodeEscape(decoder, builder, sourceOffset)?;
    } else {
      appendDecodedByte(decoder, builder, narrowByte(value), sourceOffset)?;
    }
  }
  return Err(
    Error.UnexpectedEnd {
      path: [],
      expected: "a closing quote",
      span: Span { start: stringStart, end: decoderLength(decoder) },
    },
  );
}

fn tokenBoundary(value: int): bool {
  return value < 0 || whitespace(value) || value == 44 || value == 93 || value == 125;
}

fn expectLiteral(decoder: Decoder, literal: bytes.Bytes, expected: string): Result<void, Error> {
  skipWhitespace(decoder);
  const start = decoder.offset;
  if decoderLength(decoder) - start < bytes.length(literal) {
    return Err(unexpected(decoder, expected));
  }
  for index in 0..bytes.length(literal) {
    if bytes.get(decoder.input, start + index) != bytes.get(literal, index) {
      return Err(unexpected(decoder, expected));
    }
  }
  decoder.offset += bytes.length(literal);
  if !tokenBoundary(peek(decoder)) {
    return Err(unexpected(decoder, "the end of a JSON literal"));
  }
  return Ok();
}

fn digit(value: int): bool {
  return value >= 48 && value <= 57;
}

fn numberEnd(decoder: Decoder): Result<int, Error> {
  skipWhitespace(decoder);
  const start = decoder.offset;
  if peek(decoder) == 45 {
    decoder.offset += 1;
  }
  if peek(decoder) == 48 {
    decoder.offset += 1;
    if digit(peek(decoder)) {
      return Err(Error.InvalidNumber { path: [], span: Span { start, end: decoder.offset + 1 } });
    }
  } else {
    if peek(decoder) < 49 || peek(decoder) > 57 {
      return Err(
        Error.InvalidNumber { path: [], span: byteSpan(decoder.offset, decoderLength(decoder)) },
      );
    }
    while digit(peek(decoder)) {
      decoder.offset += 1;
    }
  }
  if peek(decoder) == 46 {
    decoder.offset += 1;
    if !digit(peek(decoder)) {
      return Err(
        Error.InvalidNumber { path: [], span: byteSpan(decoder.offset, decoderLength(decoder)) },
      );
    }
    while digit(peek(decoder)) {
      decoder.offset += 1;
    }
  }
  if peek(decoder) == 101 || peek(decoder) == 69 {
    decoder.offset += 1;
    if peek(decoder) == 43 || peek(decoder) == 45 {
      decoder.offset += 1;
    }
    if !digit(peek(decoder)) {
      return Err(
        Error.InvalidNumber { path: [], span: byteSpan(decoder.offset, decoderLength(decoder)) },
      );
    }
    while digit(peek(decoder)) {
      decoder.offset += 1;
    }
  }
  if decoder.offset - start > decoder.limits.numberBytes {
    return Err(limitError("number bytes", decoder.limits.numberBytes, start, decoder.offset));
  }
  if !tokenBoundary(peek(decoder)) {
    return Err(
      Error.InvalidNumber { path: [], span: byteSpan(decoder.offset, decoderLength(decoder)) },
    );
  }
  return Ok(decoder.offset);
}

fn rawNumber(decoder: Decoder): Result<string, Error> {
  skipWhitespace(decoder);
  const start = decoder.offset;
  const end = numberEnd(decoder)?;
  const value = match bytes.slice(decoder.input, start, end) {
    Ok(result) => result,
    Err(_) => panic("std/json number slice"),
  };
  return match bytes.decodeUtf8(value) {
    Ok(text) => Ok(text),
    Err(_) => panic("std/json validated number UTF-8"),
  };
}

public fn newDecoder(input: bytes.Bytes, limits: Limits): Result<Decoder, Error> {
  if !validLimits(limits) {
    return Err(Error.InvalidLimits);
  }
  const length = bytes.length(input);
  if length > limits.inputBytes {
    return Err(limitError("input bytes", limits.inputBytes, 0, length));
  }
  const _ = match bytes.decodeUtf8(input) {
    Ok(text) => text,
    Err(error) => match error {
      bytes.Invalid { offset } => {
        return Err(Error.InvalidUtf8 { span: byteSpan(offset, length), path: [] });
      },
    },
  };
  return Ok(
    Decoder {
      input: bytes.copy(input),
      limits,
      offset: 0,
      frames: [],
      lastKeyStart: 0,
      lastKeyEnd: 0,
    },
  );
}

public fn finishDecoder(decoder: Decoder): Result<void, Error> {
  skipWhitespace(decoder);
  if decoder.frames.length() != 0 {
    return Err(unexpected(decoder, "the end of the current JSON container"));
  }
  if decoder.offset != decoderLength(decoder) {
    return Err(unexpected(decoder, "the end of input"));
  }
  return Ok();
}

public fn readString(decoder: Decoder): Result<string, Error> {
  return parseString(decoder);
}

public fn readBool(decoder: Decoder): Result<bool, Error> {
  skipWhitespace(decoder);
  if peek(decoder) == 116 {
    expectLiteral(decoder, bytes.encodeUtf8("true"), "true or false")?;
    return Ok(true);
  }
  if peek(decoder) == 102 {
    expectLiteral(decoder, bytes.encodeUtf8("false"), "true or false")?;
    return Ok(false);
  }
  return Err(unexpected(decoder, "true or false"));
}

public fn readNull(decoder: Decoder): Result<void, Error> {
  return expectLiteral(decoder, bytes.encodeUtf8("null"), "null");
}

public fn readNumber(decoder: Decoder): Result<string, Error> {
  return rawNumber(decoder);
}

public fn readInt(decoder: Decoder): Result<int, Error> {
  skipWhitespace(decoder);
  const start = decoder.offset;
  const text = rawNumber(decoder)?;
  return match convert.parseInt(text) {
    Ok(value) => Ok(value),
    Err(error) => match error {
      convert.OutOfRange => Err(
        Error.NumberOutOfRange { path: [], span: Span { start, end: decoder.offset } },
      ),
      _ => Err(Error.InvalidNumber { path: [], span: Span { start, end: decoder.offset } }),
    },
  };
}

fn pushDecodeFrame(decoder: Decoder, kind: int): Result<void, Error> {
  if decoder.frames.length() == decoder.limits.nesting {
    return Err(limitError("nesting", decoder.limits.nesting, decoder.offset, decoder.offset));
  }
  const _ = decoder.frames.push(
    DecoderFrame { kind, first: true, count: 0, keys: mapOf<string, bool>() },
  );
  return Ok();
}

fn popDecodeFrame(decoder: Decoder): void {
  const _ = decoder.frames.pop();
}

public fn beginObject(decoder: Decoder): Result<void, Error> {
  skipWhitespace(decoder);
  if peek(decoder) != 123 {
    return Err(unexpected(decoder, "an object"));
  }
  pushDecodeFrame(decoder, 1)?;
  decoder.offset += 1;
  return Ok();
}

public fn nextField(decoder: Decoder): Result<Option<string>, Error> {
  if decoder.frames.length() == 0 || decoder.frames[decoder.frames.length() - 1].kind != 1 {
    return Err(unexpected(decoder, "an open object"));
  }
  const frame = decoder.frames[decoder.frames.length() - 1];
  skipWhitespace(decoder);
  if peek(decoder) == 125 {
    decoder.offset += 1;
    popDecodeFrame(decoder);
    return Ok(None);
  }
  if !frame.first {
    if peek(decoder) != 44 {
      return Err(unexpected(decoder, "a comma or closing brace"));
    }
    decoder.offset += 1;
    skipWhitespace(decoder);
    if peek(decoder) == 125 {
      return Err(unexpected(decoder, "an object field after the comma"));
    }
  }
  const keyStart = decoder.offset;
  const key = parseString(decoder)?;
  const keyEnd = decoder.offset;
  skipWhitespace(decoder);
  if peek(decoder) != 58 {
    return Err(unexpected(decoder, "a colon after the object field"));
  }
  decoder.offset += 1;
  if frame.keys.containsKey(key) {
    return Err(
      Error.DuplicateField {
        path: [PathSegment.Field { name: key }],
        name: key,
        span: Span { start: keyStart, end: keyEnd },
      },
    );
  }
  if frame.count == decoder.limits.items {
    return Err(limitError("object fields", decoder.limits.items, keyStart, keyEnd));
  }
  const _ = frame.keys.put(key, true);
  frame.count += 1;
  frame.first = false;
  decoder.lastKeyStart = keyStart;
  decoder.lastKeyEnd = keyEnd;
  return Ok(Some(key));
}

public fn beginArray(decoder: Decoder): Result<void, Error> {
  skipWhitespace(decoder);
  if peek(decoder) != 91 {
    return Err(unexpected(decoder, "an array"));
  }
  pushDecodeFrame(decoder, 0)?;
  decoder.offset += 1;
  return Ok();
}

public fn nextElement(decoder: Decoder): Result<bool, Error> {
  if decoder.frames.length() == 0 || decoder.frames[decoder.frames.length() - 1].kind != 0 {
    return Err(unexpected(decoder, "an open array"));
  }
  const frame = decoder.frames[decoder.frames.length() - 1];
  skipWhitespace(decoder);
  if peek(decoder) == 93 {
    decoder.offset += 1;
    popDecodeFrame(decoder);
    return Ok(false);
  }
  if !frame.first {
    if peek(decoder) != 44 {
      return Err(unexpected(decoder, "a comma or closing bracket"));
    }
    decoder.offset += 1;
    skipWhitespace(decoder);
    if peek(decoder) == 93 {
      return Err(unexpected(decoder, "an array element after the comma"));
    }
    if peek(decoder) < 0 {
      return Err(unexpected(decoder, "an array element after the comma"));
    }
  }
  if frame.count == decoder.limits.items {
    return Err(limitError("array items", decoder.limits.items, decoder.offset, decoder.offset));
  }
  frame.count += 1;
  frame.first = false;
  return Ok(true);
}

public fn readBytes(decoder: Decoder): Result<bytes.Bytes, Error> {
  beginArray(decoder)?;
  const result = bytes.new();
  while nextElement(decoder)? {
    const start = decoder.offset;
    const value = readInt(decoder)?;
    if value < 0 || value > 255 {
      return Err(Error.NumberOutOfRange { path: [], span: Span { start, end: decoder.offset } });
    }
    const _ = bytes.push(result, narrowByte(value));
  }
  return Ok(result);
}

public fn skipValue(decoder: Decoder): Result<void, Error> {
  const outerDepth = decoder.frames.length();
  let needValue = true;
  while needValue || decoder.frames.length() > outerDepth {
    if needValue {
      skipWhitespace(decoder);
      const value = peek(decoder);
      if value == 123 {
        beginObject(decoder)?;
      } else if value == 91 {
        beginArray(decoder)?;
      } else if value == 34 {
        const _ = readString(decoder)?;
      } else if value == 116 || value == 102 {
        const _ = readBool(decoder)?;
      } else if value == 110 {
        readNull(decoder)?;
      } else if value == 45 || digit(value) {
        const _ = readNumber(decoder)?;
      } else {
        return Err(unexpected(decoder, "a JSON value"));
      }
      needValue = false;
    } else if decoder.frames.length() > outerDepth {
      const kind = decoder.frames[decoder.frames.length() - 1].kind;
      if kind == 1 {
        needValue = match nextField(decoder)? {
          Some(_) => true,
          None => false,
        };
      } else {
        needValue = nextElement(decoder)?;
      }
    }
  }
  return Ok();
}

public fn handleUnknown(
  decoder: Decoder,
  name: string,
  policy: UnknownFields,
): Result<void, Error> {
  return match policy {
    Reject => Err(
      Error.UnknownField {
        path: [PathSegment.Field { name }],
        name,
        span: Span { start: decoder.lastKeyStart, end: decoder.lastKeyEnd },
      },
    ),
    Skip => skipValue(decoder),
  };
}

public fn missingField(decoder: Decoder, name: string): Error {
  return Error.MissingField {
    path: [PathSegment.Field { name }],
    name,
    span: emptySpan(decoder.offset),
  };
}

public fn unknownVariant(decoder: Decoder, name: string): Error {
  return Error.UnknownField { path: [], name, span: emptySpan(decoder.offset) };
}

fn validNumberText(value: string, limits: Limits): bool {
  const input = bytes.encodeUtf8(value);
  const decoder = match newDecoder(input, limits) {
    Ok(result) => result,
    Err(_) => {
      return false;
    },
  };
  const _ = match readNumber(decoder) {
    Ok(result) => result,
    Err(_) => {
      return false;
    },
  };
  return match finishDecoder(decoder) {
    Ok(_) => true,
    Err(_) => false,
  };
}
