#!/usr/bin/env python3
"""Enforce bounded Stage 0 C modules and coarse owner dependencies."""

from __future__ import annotations

import re
from dataclasses import dataclass
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
HARD_LIMIT = 1_500
PRIVATE_HEADER_LIMIT = 400
OWNER_API_HEADER_LIMIT = 160
COORDINATOR_LIMITS = {
    Path("bootstrap/src/bytecode/bytecode.c"): 900,
    Path("bootstrap/src/bytecode/vm.c"): 900,
    Path("bootstrap/src/check/checker.c"): 650,
    Path("bootstrap/src/check/checker_internal.h"): 250,
    Path("bootstrap/src/cli/cli.c"): 900,
    Path("bootstrap/src/format/formatter.c"): 1_200,
    Path("bootstrap/src/mir/mir.c"): 1_200,
    Path("bootstrap/src/parse/parser.c"): 1_200,
}
EXCEPTIONS = ROOT / "docs/implementation/architecture-exceptions.tsv"
INCLUDE = re.compile(r'^\s*#\s*include\s*["<]([^">]+)[">]', re.MULTILINE)
TEST_FUNCTION = re.compile(
    r"(?:^|\n)\s*(?:static\s+)?void\s+"
    r"(mmay_test_[A-Za-z0-9_]+)\s*\(\s*void\s*\)\s*\{"
)
TEST_CALL = re.compile(r"\b(mmay_test_[A-Za-z0-9_]+)\s*\(\s*\)\s*;")


@dataclass(frozen=True)
class ExceptionEntry:
    owner: str
    max_lines: int
    removal_checkpoint: str
    reason: str


def relative(path: Path) -> Path:
    return path.relative_to(ROOT)


def handwritten_files() -> list[Path]:
    files: set[Path] = {ROOT / "bootstrap/main.c"}
    for directory in (
        ROOT / "bootstrap/include/mmay",
        ROOT / "bootstrap/src",
        ROOT / "runtime/common",
        ROOT / "runtime/include/mmay",
        ROOT / "runtime/platform",
        ROOT / "tests/c-unit",
        ROOT / "tests/fuzz",
    ):
        for suffix in ("*.c", "*.h"):
            files.update(directory.rglob(suffix))
    return sorted(
        path for path in files if "generated" not in path.relative_to(ROOT).parts
    )


def is_public_owner_header(path: Path) -> bool:
    return (
        path.suffix == ".h"
        and path.parts[:3] in {
            ("bootstrap", "include", "mmay"),
            ("runtime", "include", "mmay"),
        }
    )


def default_line_limit(path: Path) -> int:
    ceiling = PRIVATE_HEADER_LIMIT if path.suffix == ".h" else HARD_LIMIT
    if path.name.endswith("_api.h") or is_public_owner_header(path):
        ceiling = min(ceiling, OWNER_API_HEADER_LIMIT)
    return min(ceiling, COORDINATOR_LIMITS.get(path, ceiling))


def load_exceptions() -> tuple[dict[Path, ExceptionEntry], list[str]]:
    entries: dict[Path, ExceptionEntry] = {}
    violations: list[str] = []
    if not EXCEPTIONS.is_file():
        return entries, [
            "docs/implementation/architecture-exceptions.tsv: missing registry"
        ]
    for line_number, raw_line in enumerate(
        EXCEPTIONS.read_text(encoding="utf-8").splitlines(), start=1
    ):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        columns = raw_line.split("\t")
        if len(columns) != 5 or any(not column.strip() for column in columns):
            violations.append(
                f"{relative(EXCEPTIONS)}:{line_number}: expected five non-empty "
                "tab-separated columns"
            )
            continue
        path_text, owner, max_text, removal_checkpoint, reason = (
            column.strip() for column in columns
        )
        path = Path(path_text)
        if path.is_absolute() or ".." in path.parts:
            violations.append(
                f"{relative(EXCEPTIONS)}:{line_number}: path must be repository-relative"
            )
            continue
        if path in entries:
            violations.append(
                f"{relative(EXCEPTIONS)}:{line_number}: duplicate path {path}"
            )
            continue
        try:
            max_lines = int(max_text)
        except ValueError:
            violations.append(
                f"{relative(EXCEPTIONS)}:{line_number}: max_lines is not an integer"
            )
            continue
        default_ceiling = default_line_limit(path)
        if max_lines <= default_ceiling:
            violations.append(
                f"{relative(EXCEPTIONS)}:{line_number}: an exception ceiling must be "
                f"greater than the path ceiling {default_ceiling}"
            )
            continue
        if not (ROOT / path).is_file():
            violations.append(
                f"{relative(EXCEPTIONS)}:{line_number}: missing exception target {path}"
            )
            continue
        entries[path] = ExceptionEntry(
            owner=owner,
            max_lines=max_lines,
            removal_checkpoint=removal_checkpoint,
            reason=reason,
        )
    return entries, violations


def line_count(path: Path) -> int:
    with path.open("rb") as source:
        return sum(1 for _ in source)


def line_limit_violation(
    path: Path,
    count: int,
    exceptions: dict[Path, ExceptionEntry],
) -> str | None:
    default_ceiling = default_line_limit(path)
    ceiling = exceptions[path].max_lines if path in exceptions else default_ceiling
    if count <= ceiling:
        return None
    suffix = (
        f" (temporary owner {exceptions[path].owner}, removal "
        f"{exceptions[path].removal_checkpoint})"
        if path in exceptions
        else ""
    )
    return f"{path}: {count} physical lines exceeds ceiling {ceiling}{suffix}"


def public_header_policy_regression_violations() -> list[str]:
    """Keep the non-bytecode public-header ceiling wired into the gate."""
    fixture = Path("bootstrap/include/mmay/check/oversized-regression.h")
    accepted = line_limit_violation(fixture, OWNER_API_HEADER_LIMIT, {})
    rejected = line_limit_violation(fixture, OWNER_API_HEADER_LIMIT + 1, {})
    discovered = {relative(path) for path in handwritten_files()}
    violations: list[str] = []
    for required in (
        Path("bootstrap/include/mmay/check/checker.h"),
        Path("runtime/include/mmay/runtime/managed.h"),
    ):
        if required not in discovered:
            violations.append(
                f"check-architecture regression: public header scan omitted {required}"
            )
    if accepted is not None:
        violations.append(
            "check-architecture regression: a 160-line public checker header "
            "was rejected"
        )
    if rejected is None or "exceeds ceiling 160" not in rejected:
        violations.append(
            "check-architecture regression: an oversized non-bytecode public "
            "header was not rejected"
        )
    return violations


def line_limit_violations(exceptions: dict[Path, ExceptionEntry]) -> list[str]:
    violations: list[str] = []
    discovered = {relative(path) for path in handwritten_files()}
    for path in sorted(discovered):
        count = line_count(ROOT / path)
        violation = line_limit_violation(path, count, exceptions)
        if violation is not None:
            violations.append(violation)
    for path in sorted(exceptions.keys() - discovered):
        violations.append(
            f"{path}: exception target is outside checked handwritten C/header"
        )
    return violations


def include_violations() -> list[str]:
    violations: list[str] = []
    forbidden_by_owner = {
        "check": ("mmay/bytecode/", "mmay/native/", "mmay/runtime/"),
        "mir": ("mmay/ast/", "mmay/bytecode/", "mmay/check/", "mmay/native/", "mmay/parse/"),
        "bytecode": ("mmay/ast/", "mmay/check/", "mmay/native/", "mmay/parse/"),
        "native": ("mmay/ast/", "mmay/bytecode/", "mmay/check/", "mmay/parse/"),
    }
    generated_includes = {
        "../generated/opcode_data.inc",
        "../generated/syntax_data.inc",
        "../generated/token_data.inc",
    }
    for path in handwritten_files():
        path_relative = relative(path)
        source = path.read_text(encoding="utf-8")
        owner = (
            path_relative.parts[2]
            if len(path_relative.parts) >= 3
            and path_relative.parts[:2] == ("bootstrap", "src")
            else None
        )
        for match in INCLUDE.finditer(source):
            include = match.group(1)
            line = source.count("\n", 0, match.start()) + 1
            if include.endswith(".c"):
                violations.append(
                    f"{path_relative}:{line}: including a C translation unit is forbidden"
                )
            if include.endswith(".inc") and include not in generated_includes:
                violations.append(
                    f"{path_relative}:{line}: handwritten .inc shards are forbidden"
                )
            if owner is not None:
                for prefix in forbidden_by_owner.get(owner, ()):
                    if include.startswith(prefix):
                        violations.append(
                            f"{path_relative}:{line}: owner {owner} must not depend on {include}"
                        )
    for inc in sorted((ROOT / "bootstrap").rglob("*.inc")):
        if "generated" not in relative(inc).parts:
            violations.append(f"{relative(inc)}: handwritten .inc shard is forbidden")
    for inc in sorted((ROOT / "runtime").rglob("*.inc")):
        if "generated" not in relative(inc).parts:
            violations.append(f"{relative(inc)}: handwritten .inc shard is forbidden")
    return violations


def cmake_registration_violations() -> list[str]:
    cmake_text = "\n".join(
        path.read_text(encoding="utf-8") for path in sorted(ROOT.rglob("CMakeLists.txt"))
    )
    candidates: list[Path] = []
    candidates.extend((ROOT / "bootstrap/src").rglob("*.c"))
    candidates.extend((ROOT / "runtime/common").rglob("*.c"))
    candidates.extend((ROOT / "runtime/platform").rglob("*.c"))
    candidates.extend((ROOT / "tests/c-unit").rglob("*.c"))
    candidates.extend((ROOT / "tests/fuzz").rglob("*.c"))
    violations: list[str] = []
    for path in sorted(candidates):
        path_relative = relative(path)
        if path_relative.parts[:2] in {
            ("bootstrap", "src"),
            ("runtime", "common"),
            ("runtime", "platform"),
        }:
            registered_spellings = {path_relative.as_posix()}
        elif path_relative.parts[:2] == ("tests", "c-unit"):
            registered_spellings = {path.name, f"../fuzz/{path.name}"}
        else:
            registered_spellings = {path.name, f"../fuzz/{path.name}"}
        fuzz_template_registration = (
            path_relative.parts[:2] == ("tests", "fuzz")
            and path.name.endswith("_fuzz.c")
            and "${mmay_fuzz_target}_fuzz.c" in cmake_text
            and re.search(
                rf"^\s*{re.escape(path.name.removesuffix('_fuzz.c'))}\s*$",
                cmake_text,
                re.MULTILINE,
            )
            is not None
        )
        if not fuzz_template_registration and not any(
            spelling in cmake_text for spelling in registered_spellings
        ):
            violations.append(
                f"{path_relative}: C translation unit is not registered in CMake"
            )
    return violations


def matching_c_brace(source: str, opening: int) -> int:
    """Return the matching brace while ignoring C comments and literals."""
    depth = 0
    index = opening
    state = "code"
    while index < len(source):
        char = source[index]
        following = source[index + 1] if index + 1 < len(source) else ""
        if state == "code":
            if char == "/" and following == "/":
                state = "line-comment"
                index += 2
                continue
            if char == "/" and following == "*":
                state = "block-comment"
                index += 2
                continue
            if char == '"':
                state = "string"
            elif char == "'":
                state = "character"
            elif char == "{":
                depth += 1
            elif char == "}":
                depth -= 1
                if depth == 0:
                    return index
        elif state == "line-comment":
            if char == "\n":
                state = "code"
        elif state == "block-comment":
            if char == "*" and following == "/":
                state = "code"
                index += 2
                continue
        elif char == "\\":
            index += 2
            continue
        elif (state == "string" and char == '"') or (
            state == "character" and char == "'"
        ):
            state = "code"
        index += 1
    raise ValueError("unterminated C function body")


def c_function_body(source: str, match: re.Match[str]) -> str:
    opening = source.find("{", match.start(), match.end())
    closing = matching_c_brace(source, opening)
    return source[opening + 1 : closing]


def test_owner_violations() -> list[str]:
    """Require every no-argument C test function to have one CTest owner."""
    definitions: dict[str, tuple[Path, str]] = {}
    violations: list[str] = []
    for path in sorted((ROOT / "tests/c-unit").rglob("*.c")):
        source = path.read_text(encoding="utf-8")
        for match in TEST_FUNCTION.finditer(source):
            name = match.group(1)
            if name in definitions:
                violations.append(
                    f"{relative(path)}: duplicate C test function {name}; first "
                    f"defined in {relative(definitions[name][0])}"
                )
                continue
            definitions[name] = (path, c_function_body(source, match))

    main_path = ROOT / "tests/c-unit/test_main.c"
    main_source = main_path.read_text(encoding="utf-8")
    shard_match = re.search(
        r"static\s+void\s+mmay_test_run_suite_shard\s*\([^)]*\)\s*\{",
        main_source,
    )
    if shard_match is None:
        return ["tests/c-unit/test_main.c: missing suite-shard coordinator"]
    shard_body = c_function_body(main_source, shard_match)
    owners: dict[str, set[str]] = {}
    for case in re.finditer(
        r"\bcase\s+(\d+)\s*:(.*?)\bbreak\s*;", shard_body, re.DOTALL
    ):
        owners[f"suite-shard-{case.group(1)}"] = set(
            TEST_CALL.findall(case.group(2))
        )

    focused_helpers = sorted(
        name for name in definitions if re.fullmatch(r"mmay_test_run_cp\d+", name)
    )
    for name in focused_helpers:
        owners[name.removeprefix("mmay_test_run_")] = set(
            TEST_CALL.findall(definitions[name][1])
        )

    cmake_source = (ROOT / "tests/c-unit/CMakeLists.txt").read_text(
        encoding="utf-8"
    )
    registered_focused = re.findall(
        r"^mmay_add_focused_checkpoint_test\((cp\d+)\s+\d+\)\s*$",
        cmake_source,
        re.MULTILINE,
    )
    expected_focused = [
        name.removeprefix("mmay_test_run_") for name in focused_helpers
    ]
    if sorted(registered_focused) != sorted(expected_focused):
        violations.append(
            "tests/c-unit/CMakeLists.txt: focused CTest owners do not match "
            f"test_main helpers: registered={registered_focused}, "
            f"helpers={expected_focused}"
        )

    call_graph = {
        name: set(TEST_CALL.findall(body)) & definitions.keys()
        for name, (_, body) in definitions.items()
    }
    memberships: dict[str, set[str]] = {}
    for owner, roots in owners.items():
        pending = list(roots)
        reached: set[str] = set()
        while pending:
            name = pending.pop()
            if name in reached or name not in definitions:
                continue
            reached.add(name)
            pending.extend(call_graph[name] - reached)
        for name in reached:
            if not name.startswith("mmay_test_run_"):
                memberships.setdefault(name, set()).add(owner)

    for name, owner_names in sorted(memberships.items()):
        if len(owner_names) > 1:
            path = relative(definitions[name][0])
            violations.append(
                f"{path}: {name} has multiple CTest owners: "
                + ", ".join(sorted(owner_names))
            )

    coordinator_names = set(focused_helpers)
    for name, (path, _) in sorted(definitions.items()):
        if name not in memberships and name not in coordinator_names:
            violations.append(
                f"{relative(path)}: {name} has no CTest owner reachable from "
                "the suite coordinator"
            )
    return violations


def main() -> int:
    exceptions, violations = load_exceptions()
    violations.extend(public_header_policy_regression_violations())
    violations.extend(line_limit_violations(exceptions))
    violations.extend(include_violations())
    violations.extend(cmake_registration_violations())
    violations.extend(test_owner_violations())
    if violations:
        print("check-architecture: failed")
        for violation in violations:
            print(violation)
        return 1
    print("check-architecture: ok")
    return 0


raise SystemExit(main())
