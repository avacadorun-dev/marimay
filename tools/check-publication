#!/usr/bin/env python3
"""Check tracked source for private infrastructure and unsafe public CI settings.

This offline guard complements Gitleaks. It is not a general proof of privacy.
Use --history to inspect every reachable blob and commit, not only the index.
"""
import argparse
import gzip
import re
import subprocess
import zlib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PATTERNS = {
    "home or personal mount path": rb"/(?:Users|home|Volumes)/[^/\s\"'<>\\]+",
    "Windows home path": rb"[A-Za-z]:[\\/]+(?:Users|home)[\\/]+[^\\/\s\"'<>]+",
    "private IPv4 endpoint": rb"(?<![\d.])(?:192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3})(?![\d.])",
    "private host URL": rb"(?i)(?:https?|ssh)://[^/\s\"<>]*(?:\.local|\.lan|\.internal)(?::\d+)?(?:/|\b)",
    "SSH remote": rb"(?:ssh" + rb"://[^\s\"<>]+|git" + rb"@[^\s\"<>]+)",
    "credential-bearing URL": rb"(?:https?|ssh)://[^\s/:\"<>]{1,128}:[^\s/@\"<>]{1,256}@",
    "provider credential": rb"(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|glpat-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{15,}|AKIA[A-Z0-9]{16})",
    "private key": rb"-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----",
}
RULES = {name: re.compile(pattern) for name, pattern in PATTERNS.items()}
EMAIL = re.compile(rb"[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,253}\.[A-Za-z]{2,24}")

# Squash-merge commits authored before the account's public commit address was
# changed take their author line from the GitHub account, not from local Git
# configuration, so a later configuration fix cannot repair them. Rewriting the
# history would not un-publish them either: the pull-request refs on GitHub keep
# the same objects reachable. They are accepted as reviewed history instead.
# The exception is per object, never by address, so any new commit carrying the
# same address still fails. The list is closed (D126, amended 2026-11-11): a new
# occurrence means the merge process regressed, not that this table grows, which
# is why this repository now merges by rebase or fast-forward instead of an API
# squash merge. See docs/security/publication.md and issue #43.
ACCEPTED_HISTORICAL_COMMITS = {
    oid: "#43 accepted squash-merge author line" + ": documented in docs/security/publication.md"
    for oid in (
        "c8d92cc68d64124f27f4b0f8b3c155e13eeb37cb",
        "9139cca425a7233a0d890054199dc536a9e7e62d",
        "f2c9bf0c54398eeb3f3fccc7b2255af2943089d3",
        "53b216734c8f03118cadeea348b5c12c0048fc72",
        "a24e9e40365a092a035552a5d8a22e5d7e793d7a",
        "a9848597a580004a1cbde62c6c2fe46fb5f2ea5f",
        "39dd34698eced227b799f937f8ffb8bd8b6cbe2c",
    )
}


def inspect(data, label):
    if data.startswith(b"\x1f\x8b"):
        try:
            data = gzip.decompress(data)
        except (OSError, EOFError) as error:
            return [f"{label}: invalid gzip ({type(error).__name__})"]
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        return png_metadata(data, label)
    issues = []
    for name, rule in RULES.items():
        hints = {
            "home or personal mount path": (b"Users", b"home", b"Volumes"),
            "Windows home path": (b"Users", b"home"),
            "private IPv4 endpoint": (b"192.168.", b"10.", b"172."),
            "private host URL": (b".local", b".lan", b".internal"),
            "SSH remote": (b"ssh" + b"://", b"git" + b"@"),
            "credential-bearing URL": (b"://",),
            "provider credential": (b"gh", b"glpat-", b"xox", b"AKIA"),
            "private key": (b"PRIVATE KEY",),
        }
        if any(hint in data for hint in hints[name]) and rule.search(data):
            issues.append(f"{label}: {name}")
    for marker in re.finditer(b"@", data):
        nearby = data[max(0, marker.start() - 64):marker.end() + 280]
        for address in EMAIL.findall(nearby):
            domain = address.rsplit(b"@", 1)[1].lower()
            if address != b"noreply@github.com" and domain != b"users.noreply.github.com" and not domain.endswith((b".invalid", b".example")):
                issues.append(f"{label}: non-placeholder email address")
                return issues
    return issues


def png_metadata(data, label):
    """Scan PNG text metadata without treating compressed pixels as text."""
    offset = 8
    issues = []
    while offset < len(data):
        if len(data) - offset < 12:
            return issues + [f"{label}: malformed PNG chunk"]
        size = int.from_bytes(data[offset:offset + 4], "big")
        kind = data[offset + 4:offset + 8]
        if size > len(data) - offset - 12:
            return issues + [f"{label}: malformed PNG chunk size"]
        chunk = data[offset + 8:offset + 8 + size]
        offset += 12 + size
        try:
            if kind == b"tEXt":
                issues.extend(inspect(chunk.replace(b"\0", b" "), label + " PNG text"))
            elif kind == b"zTXt":
                _, rest = chunk.split(b"\0", 1)
                if rest[0] != 0:
                    raise ValueError("unknown PNG compression")
                issues.extend(inspect(zlib.decompress(rest[1:]), label + " PNG text"))
            elif kind == b"iTXt":
                _, rest = chunk.split(b"\0", 1)
                compressed, method = rest[:2]
                _, _, text = rest[2:].split(b"\0", 2)
                if compressed not in (0, 1) or method != 0:
                    raise ValueError("unknown PNG compression")
                issues.extend(inspect(zlib.decompress(text) if compressed else text,
                                      label + " PNG text"))
            elif kind == b"eXIf":
                issues.append(f"{label}: strip EXIF before publication")
            elif kind == b"IEND":
                return issues if offset == len(data) else issues + [f"{label}: trailing PNG data"]
        except (ValueError, IndexError, zlib.error):
            issues.append(f"{label}: malformed PNG text metadata")
    return issues + [f"{label}: PNG missing IEND"]


def history():
    lines = subprocess.check_output(["git", "rev-list", "--objects", "--all"], cwd=ROOT).splitlines()
    process = subprocess.Popen(["git", "cat-file", "--batch"], cwd=ROOT,
                               stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    try:
        for line in lines:
            oid, _, name = line.partition(b" ")
            process.stdin.write(oid + b"\n")
            process.stdin.flush()
            header = process.stdout.readline().split()
            size = int(header[2])
            data = process.stdout.read(size)
            if len(data) != size or process.stdout.read(1) != b"\n":
                raise RuntimeError("incomplete Git object read")
            if header[1] in (b"blob", b"commit", b"tag"):
                yield data, name.decode("utf-8", "replace") or "commit/tag metadata", oid.decode()
    finally:
        process.stdin.close()
        process.stdout.close()
        if process.wait() != 0:
            raise RuntimeError("git cat-file failed")


def workflow_issues(text, label):
    issues = []
    for word in ("pull_request_target", "self-hosted", "secrets."):
        if word in text:
            issues.append(f"{label}: prohibited privileged trigger, runner, or secret context")
    if not re.search(r"^permissions:\n  contents: read\n", text, re.M):
        issues.append(f"{label}: explicit read-only contents permission required")
    jobs = dict(re.findall(r"^  ([a-zA-Z0-9_-]+):\n(.*?)(?=^  [a-zA-Z0-9_-]+:|\Z)",
                           text.split("\njobs:\n", 1)[-1], re.M | re.S))
    lines = text.splitlines()
    for index, line in enumerate(lines):
        permission = re.fullmatch(r"( *)permissions:(.*)", line)
        if not permission:
            continue
        if permission[2].strip():
            issues.append(f"{label}: permissions must use an explicit block mapping")
            continue
        indent = len(permission[1])
        values = {}
        for child in lines[index + 1:]:
            if not child.strip() or child.lstrip().startswith("#"):
                continue
            child_indent = len(child) - len(child.lstrip(" "))
            if child_indent <= indent:
                break
            entry = re.fullmatch(r" {" + str(indent + 2) + r"}([a-z-]+): (read|write|none)", child)
            if not entry or entry[1] in values:
                issues.append(f"{label}: ambiguous permission declaration")
                continue
            values[entry[1]] = entry[2]
        writes = {key for key, value in values.items() if value == "write"}
        if not writes:
            continue
        publish = jobs.get("publish", "")
        gates = re.findall(r"^    (needs|if): (.+)$", publish, re.M)
        expected_gates = [("needs", "[prepare, security, build, verified-ci]"),
                          ("if", "github.event_name != 'pull_request' && needs.prepare.outputs.publish == 'true'")]
        allowed = (label == ".github/workflows/release.yml" and indent == 4
                   and values == {"contents": "write", "actions": "read"}
                   and sorted(gates) == sorted(expected_gates)
                   and "always()" not in publish and "continue-on-error" not in publish)
        # Find this exact block's owning job; another job cannot borrow the
        # approved publish declaration merely because publish also exists.
        owner = None
        for previous in lines[:index]:
            match = re.fullmatch(r"  ([a-zA-Z0-9_-]+):", previous)
            if match:
                owner = match[1]
        if not allowed or owner != "publish":
            issues.append(f"{label}: write permission is restricted to the gated release publisher")
    for match in re.finditer(r"uses:\s*([^\s#]+)", text):
        local_security = (label == ".github/workflows/release.yml"
                          and match[1] == "./.github/workflows/security.yml")
        if not local_security and not re.fullmatch(r"[\w.-]+/[\w./-]+@[0-9a-f]{40}", match[1]):
            issues.append(f"{label}: action must be pinned to a full commit")
    for block in text.split("uses: actions/checkout@")[1:]:
        if "persist-credentials: false" not in block.split("      - name:", 1)[0]:
            issues.append(f"{label}: checkout must not persist credentials")
    return issues


def workflows():
    issues = []
    for path in (ROOT / ".github/workflows").glob("*.yml"):
        label = str(path.relative_to(ROOT))
        issues.extend(workflow_issues(path.read_text(), label))
    return issues


def history_findings(data, label, oid):
    """Findings for one historical object, with the reviewed exception applied.

    Only the email rule is dropped for an accepted squash-merge object: personal
    paths, credentials, endpoints and every other rule still apply to it.
    """
    findings = inspect(data, label)
    reviewed = oid in ACCEPTED_HISTORICAL_COMMITS and label == "commit/tag metadata"
    if not reviewed:
        return findings, False
    remaining = [item for item in findings if not item.endswith("non-placeholder email address")]
    return remaining, len(remaining) != len(findings)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--history", action="store_true")
    args = parser.parse_args()
    issues = []
    count = 0
    if args.history:
        entries = history()
    else:
        names = subprocess.check_output(["git", "ls-files", "-z"], cwd=ROOT).split(b"\0")
        entries = (((ROOT / name.decode()).read_bytes(), name.decode(), "")
                   for name in names if name and (ROOT / name.decode()).is_file())
    accepted = 0
    for data, label, oid in entries:
        count += 1
        findings, suppressed = history_findings(data, label, oid)
        issues.extend(findings)
        accepted += int(suppressed)
    issues.extend(workflows())
    for issue in sorted(set(issues)):
        print(issue)
    summary = f"publication privacy: {count} inputs checked, {len(set(issues))} findings"
    if accepted:
        summary += f", {accepted} reviewed historical author lines"
    print(summary)
    return bool(issues)


if __name__ == "__main__":
    raise SystemExit(main())
