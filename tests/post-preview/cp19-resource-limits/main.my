import { Error as IoError, println } from "std/io";

fn excessiveGrowth(values: []int): Result<bool, ArrayGrowthError> {
  values.reserve(9223372036854775807)?;
  return Ok(false);
}

fn grow(values: []int): Result<bool, ArrayGrowthError> {
  values.reserve(8)?;
  values.push(4)?;
  return Ok(true);
}

fn semanticLengthLimit(values: []int): bool {
  return match excessiveGrowth(values) {
    case Ok(_) => false;
    case Err(LengthLimit { limit }) => limit == 9223372036854775807;
    case Err(_) => false;
  };
}

fn managedFamiliesWork(): bool {
  let raw = [1, 2, 3];
  let nested = [[1], [2, 3]];
  const grown = match grow(raw) {
    case Ok(value) => value;
    case Err(_) => false;
  };
  if !grown || !semanticLengthLimit(raw) {
    return false;
  }
  return raw.length() == 4 && nested.length() == 2 && nested[1][1] == 3;
}

fn main(): Result<void, IoError> {
  if !managedFamiliesWork() {
    panic("checkpoint 19 resource policy changed");
  }
  println("cp19 resource limits ok")?;
  return Ok();
}
