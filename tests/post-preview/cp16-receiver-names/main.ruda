import { Error as IoError, println } from "std/io";

import { interfaceStackScore, newHeap, newQueue, newStack } from "example/cp16-receiver-names/collections";
import { namedStack, namespaceQueue, typeOnlyHeap, typeOnlyQueue, typeOnlyStack } from "example/cp16-receiver-names/consumer";

fn checkpoint16Works(): bool {
  return typeOnlyStack(newStack()) == 170 && typeOnlyQueue(newQueue()) == 180 && typeOnlyHeap(
    newHeap(),
  ) == 190 && namedStack(newStack()) == 4141 && namespaceQueue(newQueue()) == 4188 && interfaceStackScore() == 290;
}

fn main(): Result<void, IoError> {
  if !checkpoint16Works() {
    panic("checkpoint 16 receiver-name resolution changed");
  }
  println("cp16 receiver names ok")?;
  return Ok();
}
