public enum Choice<T> {
  None,
  Some(T),
}

public enum Problem {
  Missing,
  Rejected(int),
}

public fn some(values: []int): Result<Choice<[]int>, Problem> {
  return Ok<Choice<[]int>, Problem>(Choice.Some(values));
}

public fn none(): Result<Choice<[]int>, Problem> {
  return Ok(Choice.None);
}

public fn failure(): Result<Choice<[]int>, Problem> {
  return Err<Choice<[]int>, Problem>(Problem.Rejected(9));
}

public fn nestedSome(values: []int): Result<Option<[]int>, Problem> {
  return Ok<Option<[]int>, Problem>(Some(values));
}

public fn nestedNone(): Result<Option<[]int>, Problem> {
  return Ok(None);
}
