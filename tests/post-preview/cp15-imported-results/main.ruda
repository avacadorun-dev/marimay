import { Error as IoError, println } from "std/io";

import { namespaceShadowingWorks } from "example/cp15-imported-results/collision";
import { directResultsWork, errorPropagationWorks, namespaceResultsWork, relayedResultsWork } from "example/cp15-imported-results/consumer";

fn main(): Result<void, IoError> {
  if !directResultsWork() || !errorPropagationWorks() || !namespaceResultsWork() || !namespaceShadowingWorks() || !relayedResultsWork() {
    panic("checkpoint 15 imported results changed");
  }
  println("cp15 imported results ok")?;
  return Ok();
}
