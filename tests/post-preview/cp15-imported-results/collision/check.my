import * as producer from "example/cp15-imported-results/producer";

enum Choice<T> {
  Local(T),
}

public fn namespaceShadowingWorks(): bool {
  const value: producer.Choice<[]int> = producer.Choice.Some([11]);
  return match value {
    producer.None => false,
    producer.Some(values) => values[0] == 11,
  };
}
