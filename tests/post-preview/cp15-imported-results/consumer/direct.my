import { Choice, Problem, failure, nestedNone, nestedSome, none, some } from "example/cp15-imported-results/producer";

enum ConsumerError {
  Producer(Problem),
}

fn consumerError(error: Problem): ConsumerError {
  return ConsumerError.Producer(error);
}

fn score(choice: Choice<[]int>): int {
  return match choice {
    None => 0,
    Some(values) => values[0] + values.length(),
  };
}

fn directResults(): Result<bool, ConsumerError> {
  const made: Choice<[]int> = Choice.Some([40]);
  const empty: Choice<[]int> = Choice.None;
  const first = some([39]).mapError(consumerError)?;
  const second = none().mapError(consumerError)?;
  const nestedPresent = nestedSome([10]).mapError(consumerError)?;
  const nestedAbsent = nestedNone().mapError(consumerError)?;
  const explicit: Option<[]int> = Some<[]int>([5]);
  const inferred: Option<[]int> = Some([6]);
  const nestedScore = match nestedPresent {
    Some(values) => values[0],
    None => 0,
  };
  const absentScore = match nestedAbsent {
    Some(_) => 1,
    None => 0,
  };
  const explicitScore = match explicit {
    Some(values) => values[0],
    None => 0,
  };
  const inferredScore = match inferred {
    Some(values) => values[0],
    None => 0,
  };
  const failed = failure().mapError(consumerError);
  const failureScore = match failed {
    Ok(_) => 0,
    Err(Producer(Rejected(value))) => value,
    Err(Producer(Missing)) => 1,
    Err(_) => 2,
  };
  return Ok(
    score(made) == 41
      && score(empty) == 0
      && score(first) == 40
      && score(second) == 0
      && nestedScore == 10
      && absentScore == 0
      && explicitScore == 5
      && inferredScore == 6
      && failureScore == 9,
  );
}

fn propagatedFailure(): Result<Choice<[]int>, ConsumerError> {
  return Ok(failure().mapError(consumerError)?);
}

public fn directResultsWork(): bool {
  return match directResults() {
    Ok(value) => value,
    Err(_) => false,
  };
}

public fn errorPropagationWorks(): bool {
  return match propagatedFailure() {
    Ok(_) => false,
    Err(Producer(Rejected(value))) => value == 9,
    Err(_) => false,
  };
}
