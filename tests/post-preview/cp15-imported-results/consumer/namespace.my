import * as producer from "example/cp15-imported-results/producer";

fn namespaceScore(choice: producer.Choice<[]int>): int {
  return match choice {
    producer.None => 0,
    producer.Some(values) => values[0] + values.length(),
  };
}

public fn namespaceResultsWork(): bool {
  const made: producer.Choice<[]int> = producer.Choice.Some([20]);
  const empty: producer.Choice<[]int> = producer.Choice.None;
  return namespaceScore(made) == 21 && namespaceScore(empty) == 0;
}
