@test
fn arrayMutationOperationsWork(): void {
  let values = [4, 5];
  if match values.pop() {
    Some(value) => value,
    None => 0,
  } != 5 {
    panic("pop changed");
  }
  const _ = values.reserve(4);
  const _ = values.push(6);
  const _ = values.truncate(1);
  if values.length() != 1 || values[0] != 4 {
    panic("size/capacity operation changed");
  }
  const _ = values.clear();
  if values.length() != 0 {
    panic("clear changed");
  }
}
