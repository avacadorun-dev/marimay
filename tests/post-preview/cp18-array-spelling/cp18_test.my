@test
fn nestedArrayIdentityAndMutationWork(): void {
  let rows: [][]int = [];
  const _ = rows.push([3]);
  const alias = rows;
  const _ = alias[0].push(4);
  if rows[0].length() != 2 || rows[0][1] != 4 {
    panic("nested array identity changed");
  }
}

@test
fn contextualEmptyArrayWorks(): void {
  let rows: [][]int = [];
  if rows.length() != 0 {
    panic("contextual empty array changed");
  }
}
