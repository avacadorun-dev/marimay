public type IntAdjacency = [][]int;

public fn bfs(adjacency: IntAdjacency, start: int): Option<[]int> {
  const nodeCount = adjacency.length();
  if start < 0 || start >= nodeCount {
    return None;
  }
  let distances: []int = [];
  for index in 0..nodeCount {
    const _ = distances.push(-1);
  }
  let queue: []int = [start];
  distances[start] = 0;
  let head = 0;
  while head < queue.length() {
    const node = queue[head];
    head += 1;
    for neighbor in adjacency[node] {
      if neighbor < 0 || neighbor >= nodeCount {
        return None;
      }
      if distances[neighbor] == -1 {
        distances[neighbor] = distances[node] + 1;
        const _ = queue.push(neighbor);
      }
    }
  }
  return Some(distances);
}
