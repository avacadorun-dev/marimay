import * as m from "example/cp42-function-values/mappers";
import { increment as inc } from "example/cp42-function-values/mappers";

@test
fn namedAndImportedValues(): void {
  const f: (int) => int = add;
  expect.equal(apply(f, 3), 4);
  const g = inc;
  const h = m.increment;
  expect.equal(g(4), 5);
  expect.equal(h(5), 6);
  const first: (m.First) => int = m.value;
  const second: (m.Second) => int = m.value;
  expect.equal(first(m.First { value: 1 }), 2);
  expect.equal(second(m.Second { value: 1 }), 3);
}

@test
fn escapingClosuresShareOneCell(): void {
  const a = counters();
  expect.equal(a[0](), 2);
  expect.equal(a[1](), 2);
  expect.equal(a[0](), 3);
  expect.equal(a[1](), 3);
}

@test
fn transitiveCaptureSurvivesBothParents(): void {
  const create = factory();
  const first = create();
  const second = create();
  expect.equal(first(), 2);
  expect.equal(second(), 3);
}

@test
fn captureThroughConditionalBody(): void {
  let n = 3;
  const f = (pick: bool): int => {
    if pick {
      return n;
    }
    return n + 1;
  };
  n = 4;
  expect.equal(f(true), 4);
  expect.equal(f(false), 5);
}

@test
fn freshIterationBindings(): void {
  const a: []() => int = [];
  for value in 0..3 {
    const _ = a.push((): int => value);
  }
  expect.equal(a[0](), 0);
  expect.equal(a[1](), 1);
  expect.equal(a[2](), 2);
  const b: []() => int = [];
  for value in [4, 5] {
    let n = value;
    const _ = b.push(
      (): int => {
        n += 1;
        return n;
      },
    );
  }
  expect.equal(b[0](), 5);
  expect.equal(b[1](), 6);
  expect.equal(b[0](), 6);
}

@test
fn genericEnvironmentsAndStoredValues(): void {
  const number = constant(7);
  const flag = constant(true);
  const text = constant("hello");
  expect.equal(number(), 7);
  expect.true(flag());
  expect.equal(text(), "hello");
  const box = Callback { call: number };
  expect.equal((box.call)(), 7);
  const table = mapOf<string, () => int>();
  const _ = table.put("number", number);
  if const read = table.get("number") {
    expect.equal(read(), 7);
  } else {
    panic("missing");
  }
}

@test
fn referencesKeepTheirIdentity(): void {
  const box = Box { value: 1 };
  const read = (): Box => box;
  box.value = 9;
  expect.true(identity.same(read(), box));
  expect.equal(read().value, 9);
}

@test
fn assignmentBeforeCaptureAndAfterBranch(): void {
  let x: int;
  if true {
    x = 1;
  } else {
    x = 2;
  }
  const first = (): int => x;
  x = 3;
  const second = (): int => x;
  expect.equal(first(), 3);
  expect.equal(second(), 3);
}

@test
fn calleeAndArgumentsAreEvaluatedOnceInOrder(): void {
  const trace: []int = [];
  const callee = (): (int, int) => int => {
    mark(trace, 1);
    return (a: int, b: int): int => a * 10 + b;
  };
  const arg = (value: int): int => {
    mark(trace, value);
    return value;
  };
  expect.equal(callee()(arg(2), arg(3)), 23);
  expect.equal(trace.length(), 3);
  expect.equal(trace[0], 1);
  expect.equal(trace[1], 2);
  expect.equal(trace[2], 3);
  let selected: (int) => int = add;
  const replacement = (): int => {
    selected = (value: int): int => value + 10;
    return 1;
  };
  expect.equal(selected(replacement()), 2);
  expect.equal(selected(1), 11);
}

@test
fn compoundAssignmentFreezesItsLeftValue(): void {
  let n = 3;
  const change = (): int => {
    n = 8;
    return 2;
  };
  n += change();
  expect.equal(n, 5);
  expect.equal(n + change(), 7);
  expect.equal(n, 8);
}

@test
fn closureReturnAndDeferOwnTheirScope(): void {
  const values: []int = [];
  const f = (pick: bool): int => {
    defer mark(values, 9);
    if pick {
      return 3;
    }
    return 4;
  };
  expect.equal(f(true), 3);
  expect.equal(f(false), 4);
  expect.equal(values.length(), 2);
  expect.equal(values[0], 9);
  expect.equal(values[1], 9);
}

@test
fn voidClosuresAndLocalLoops(): void {
  let n = 1;
  const f = (): void => {
    for value in 0..3 {
      if value == 1 {
        continue;
      }
      n += value;
    }
  };
  f();
  expect.equal(n, 3);
}

@test
fn captureShadowingIsLexical(): void {
  let x = 3;
  const f = (x: int): int => x + 1;
  const g = (): int => {
    const x = 7;
    return x;
  };
  expect.equal(f(5), 6);
  expect.equal(g(), 7);
  expect.equal(x, 3);
}

@test
fn managedCyclesAreValid(): void {
  let f: () => int = (): int => 0;
  const g = (): int => {
    const _ = f;
    return 7;
  };
  f = g;
  expect.equal(f(), 7);
}

@test
fn deferredValuesFreezeCalleeAndArguments(): void {
  const values: []int = [];
  let selected: (int) => void = (n: int): void => mark(values, n);
  const f = (): void => {
    defer selected(3);
    selected = (n: int): void => mark(values, n + 10);
    defer selected(4);
  };
  f();
  expect.equal(values.length(), 2);
  expect.equal(values[0], 14);
  expect.equal(values[1], 3);
}
