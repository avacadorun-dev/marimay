import * as io from "std/io";

import * as m from "example/cp42-function-values/mappers";
import { increment as inc } from "example/cp42-function-values/mappers";

type Box {
  mutable value: int,
}

type Callback {
  call: () => int,
}

fn add(value: int): int {
  return value + 1;
}

fn apply(f: (int) => int, value: int): int {
  return f(value);
}

fn constant<T>(value: T): () => T {
  return (): T => value;
}

fn counters(): []() => int {
  let n = 1;
  return [
    (): int => {
      n += 1;
      return n;
    },
    (): int => n,
  ];
}

fn factory(): () => () => int {
  let n = 1;
  return (): () => int => (): int => {
    n += 1;
    return n;
  };
}

fn mark(values: []int, value: int): void {
  const _ = values.push(value);
}

fn clean(): void {
  const _ = io.println("callback cleanup");
}

fn stop(): never {
  panic("callback stop");
}

fn main(args: []string): int {
  if args.length() > 0 {
    const f = (): never => {
      defer clean();
      stop();
    };
    f();
  }
  return 0;
}
