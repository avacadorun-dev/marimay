import * as bytes from "std/bytes";
import * as json from "std/json";

import * as failure from "local/map-error-imports/failure";
import { message as describe } from "local/map-error-imports/failure";

fn decodeInteger(source: string): Result<int, string> {
  const decoder = json.newDecoder(bytes.encodeUtf8(source), json.defaultLimits()).mapError(
    json.message,
  )?;
  const value = json.readInt(decoder).mapError(json.message)?;
  json.finishDecoder(decoder).mapError(json.message)?;
  return Ok(value);
}

@test
fn qualifiedAndNamedMappersRunOnlyOnError(): void {
  const visits = [0];
  const error = failure.Failure { visits };
  const bad: Result<int, failure.Failure> = Err(error);
  const good: Result<int, failure.Failure> = Ok(7);
  expect.equal(good.mapError(failure.message), Ok(7));
  expect.equal(visits[0], 0);
  expect.equal(bad.mapError(failure.message), Err("mapped"));
  expect.equal(visits[0], 1);
  expect.equal(bad.mapError(describe), Err("mapped"));
  expect.equal(visits[0], 2);
  const wrapped = bad.mapError(failure.Wrapped.Input);
  expect.err(wrapped);
  expect.equal(visits[0], 2);
}

@test
fn jsonMessageWorksWithoutWrapperClosures(): void {
  expect.equal(decodeInteger("42"), Ok(42));
  expect.err(decodeInteger("false"));
  expect.err(decodeInteger("42 true"));
}
