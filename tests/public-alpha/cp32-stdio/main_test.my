import { eprint, eprintln, flushStderr, flushStdout, print, println, readLine } from "std/io";

@test
fn stdoutWriteAndFlush(): void {
  expect.output(
    "out line\n",
    (): void => {
      const _ = print("out");
      const _ = println(" line");
      const _ = flushStdout();
    },
  );
}

@test
fn emptyWriteIsAValidNoOp(): void {
  expect.output(
    "",
    (): void => {
      const _ = print("");
    },
  );
}

@test
fn stderrWriteAndFlushIsIndependent(): void {
  const _ = eprint("err");
  const _ = eprintln(" line");
  const _ = flushStderr();
}

@test
fn readLineReturnsOkAtEof(): void {
  const input = readLine(32);
  const accepted = match input {
    Ok(_) => true,
    Err(_) => false,
  };
  if !accepted {
    panic("expected EOF");
  }
}
