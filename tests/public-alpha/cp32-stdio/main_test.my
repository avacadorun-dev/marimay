import { flushStdout, print, println, readLine } from "std/io";

@test
fn stdoutWriteAndFlush(): void {
  expect.output(
    "out line\n",
    (): void => {
      const _ = print("out");
      const _ = println(" line");
      const _ = flushStdout();
    },
  );
}

@test
fn readLineReturnsOkAtEof(): void {
  const input = readLine(32);
  const accepted = match input {
    Ok(_) => true,
    Err(_) => false,
  };
  if !accepted {
    panic("expected EOF");
  }
}
