import { println } from "std/io";

fn cleanup(): void {
  const _ = println("cleanup");
}

fn main(arguments: []string): int {
  defer cleanup();
  if arguments.length() == 0 {
    const _ = println("zero");
    return 0;
  }
  let index = 0;
  while index < arguments.length() {
    const _ = println(arguments[index]);
    index += 1;
  }
  if arguments.length() == 1 {
    return 255;
  }
  if arguments.length() == 2 {
    return 70;
  }
  return 23;
}
