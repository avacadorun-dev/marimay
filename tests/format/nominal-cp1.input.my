type Counter{mutable value:int;}
type Pair{first:int;second:int;}
enum Inner{Some(int),None,}
enum Envelope{Value(Inner),Empty,}
enum Ordered{Pair{first:int;second:int;},}
interface Show{show():int;}
fn next(counter:Counter):int{counter.value+=1;return counter.value;}
fn demonstrate(counter:Counter,value:Envelope):int{const pair=Pair{second:next(counter),first:next(counter),};const ordered=Ordered.Pair{second:next(counter),first:next(counter),};const selected=match value{case Value(Some(item))if item>0=>item;case Value(_)=>0;case Empty=>0;};const enumSelected=match ordered{case Pair{first,second}=>first+second;};return selected+pair.first+pair.second+enumSelected;}
