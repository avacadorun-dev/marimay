type Scalar = int;

type Qualified = pkg.User;

type Nested = Map<string, []Result<int, Error>>;

type Tuple = [string, int];

type Callback = (string, int) => Result<void, Error>;

type ArrayScalar = []int;

type ArrayNested = [][]pkg.Edge;

type ArrayGeneric = Option<[]int>;

type ArrayTuple = [][int, string];

type ArrayFunction = [](int, string) => []int;

type ArrayComment = [] /* element */[]int;

fn maximum<T: Ordered<T> & Hash<T>>(value: T): T {
  return value;
}
