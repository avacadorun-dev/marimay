fn expressions(a: int, b: int, c: int): void {
  const precedence = a + b * c;
  const left = a - b - c;
  let assigned = a;
  assigned = b;
  assigned <<= 1;
  assigned >>= 1;
  const shifted = a + 1 << b >> 1;
  const value = service.load<Result<int, Error>>(a, b)[0]?;
  const flag = !a == -b && true || false;
  const array = [a, b + c];
  const record = Box { value: a };
  const closure = (error: Error): Result<int, Error> => service.handle(error);
  const spawned = spawn service.load(a);
  const matched = match a {
    case 0 => b;
    case _ if c > 0 => c;
  };
  const textMatched = match text {
    case "ready" => 1;
    case _ => 0;
  };
  const pointMatched = match point {
    case Point { x, y } => x + y;
  };
}

fn scope(break: int, continue: int, unsafe: int): int {
  return break + continue + unsafe;
}

fn nested(value: Option<Array<Result<int, Error>>>): Option<Array<int>> {
  for const item of value {
    use(item);
  }
  for let index = 0; index < 3; index += 1 {
    if index == 1 {
      continue;
    } else if false {
      break;
    } else {
      use(index);
    }
  }
  while false {
    break;
  }
  unsafe {
    panic("checked");
  }
  {
    const local = 1;
  }
  return value;
}
