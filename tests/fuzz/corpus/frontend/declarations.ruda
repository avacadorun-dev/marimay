import * as io from "std/io";

type Pair<T> {
  first: T;
  second: T;
}

fn main(): void {
  const values = [1, 2, 3];
  for const value of values {
    io.print($"value {value}");
  }
}

const rounded: f64 = 9007199254740993.0;

fn strictFloat(value: f64): f64 {
  let result: f64 = value;
  result += 1.0;
  result *= 2.0;
  return result / 4.0;
}
