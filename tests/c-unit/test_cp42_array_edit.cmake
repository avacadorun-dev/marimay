if(NOT DEFINED MMAY_TEST_TOOL OR NOT DEFINED MMAY_TEST_SOURCE OR NOT DEFINED MMAY_TEST_WORK)
  message(FATAL_ERROR "Array-edit test variables are missing")
endif()

# This owner uses a fresh, disposable source tree; failed runs retain diagnostics.
file(REMOVE_RECURSE "${MMAY_TEST_WORK}")
file(MAKE_DIRECTORY "${MMAY_TEST_WORK}")
file(COPY "${MMAY_TEST_SOURCE}/" DESTINATION "${MMAY_TEST_WORK}/source" PATTERN ".mmay" EXCLUDE)
set(source "${MMAY_TEST_WORK}/source")

function(edit_expect status_expected error_expected)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
  if(NOT status STREQUAL "${status_expected}" OR NOT error STREQUAL "${error_expected}")
    message(FATAL_ERROR "Array edit: ${ARGN}: status=${status}; stdout=${output}; stderr=${error}")
  endif()
  set(edit_output "${output}" PARENT_SCOPE)
endfunction()

edit_expect(0 "" "${MMAY_TEST_TOOL}" fmt "${source}" --check)
edit_expect(0 "" "${MMAY_TEST_TOOL}" check "${source}")
edit_expect(0 "" "${MMAY_TEST_TOOL}" test "${source}" --engine both)
if(NOT edit_output MATCHES "9 passed; 0 failed")
  message(FATAL_ERROR "Array edit tests did not all pass: ${edit_output}")
endif()
edit_expect(0 "" "${MMAY_TEST_TOOL}" run "${source}")
if(NOT edit_output STREQUAL "")
  message(FATAL_ERROR "Array edit normal VM output: ${edit_output}")
endif()
set(panic "array edit cleanup\npanic[G4005]: array iterator invalidated by mutation\n")
edit_expect(1 "${panic}" "${MMAY_TEST_TOOL}" run "${source}" -- panic)
if(NOT edit_output STREQUAL "")
  message(FATAL_ERROR "Array edit panic VM stdout: ${edit_output}")
endif()
foreach(profile debug release)
  set(flags)
  if(profile STREQUAL "release")
    set(flags --release)
  endif()
  set(binary "${MMAY_TEST_WORK}/array-edit-${profile}${MMAY_TEST_SUFFIX}")
  edit_expect(0 "" "${MMAY_TEST_TOOL}" build "${source}" ${flags} --output "${binary}")
  edit_expect(0 "" "${binary}")
  if(NOT edit_output STREQUAL "")
    message(FATAL_ERROR "Array edit normal ${profile} output: ${edit_output}")
  endif()
  edit_expect(1 "${panic}" "${binary}" panic)
  if(NOT edit_output STREQUAL "")
    message(FATAL_ERROR "Array edit panic ${profile} stdout: ${edit_output}")
  endif()
endforeach()
