if(NOT DEFINED MMAY_TEST_TOOL OR NOT DEFINED MMAY_TEST_WORK)
  message(FATAL_ERROR "CP42 loop recovery variables are missing")
endif()
file(MAKE_DIRECTORY "${MMAY_TEST_WORK}")
set(source "fn main(): void { for (key, value) in values { break; } }\n")
foreach(index RANGE 0 29)
  string(APPEND source "fn after${index}(): void {}\n")
endforeach()
set(path "${MMAY_TEST_WORK}/tuple-loop.my")
file(WRITE "${path}" "${source}")
file(SHA256 "${path}" original_hash)
set(expected "error[P0001]: loop binding must be a single identifier\n  --> ${path}:1:23\n1 | fn main(): void { for (key, value) in values { break; } }\n  |                       ^\n")
function(reject name)
  execute_process(COMMAND "${MMAY_TEST_TOOL}" ${ARGN}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
  if(NOT status EQUAL 1 OR NOT output STREQUAL "" OR NOT error STREQUAL expected)
    message(FATAL_ERROR "CP42 ${name}: ${status}/${output}/${error}; expected ${expected}")
  endif()
endfunction()
reject(format-check fmt --check "${path}")
reject(format-write fmt "${path}")
reject(check check "${path}")
reject(vm run --engine vm "${path}")
reject(native run --engine native "${path}")
reject(build-debug build "${path}" --output "${MMAY_TEST_WORK}/invalid-debug")
reject(build-release build --release "${path}" --output "${MMAY_TEST_WORK}/invalid-release")
file(SHA256 "${path}" observed_hash)
if(NOT observed_hash STREQUAL original_hash)
  message(FATAL_ERROR "CP42 recovery rewrote invalid source")
endif()
if(EXISTS "${MMAY_TEST_WORK}/invalid-debug" OR EXISTS "${MMAY_TEST_WORK}/invalid-release")
  message(FATAL_ERROR "CP42 recovery published an invalid native program")
endif()
