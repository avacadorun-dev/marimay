if(NOT DEFINED MMAY_TEST_TOOL OR NOT DEFINED MMAY_TEST_SOURCE)
  message(FATAL_ERROR "local execution test variables are missing")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(root "${CMAKE_CURRENT_BINARY_DIR}/local-execution-${nonce}")
file(MAKE_DIRECTORY "${root}")

function(succeeds name)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180)
  if(NOT status EQUAL 0 OR NOT error STREQUAL "")
    message(FATAL_ERROR "local execution ${name}: ${status}/${output}/${error}")
  endif()
  set("observed_${name}" "${output}" PARENT_SCOPE)
endfunction()

succeeds(format "${MMAY_TEST_TOOL}" fmt "${MMAY_TEST_SOURCE}" --check)
succeeds(check "${MMAY_TEST_TOOL}" check "${MMAY_TEST_SOURCE}")
succeeds(tests "${MMAY_TEST_TOOL}" test "${MMAY_TEST_SOURCE}" --engine both)
if(NOT observed_tests MATCHES "1 passed; 0 failed")
  message(FATAL_ERROR "local execution test not executed: ${observed_tests}")
endif()

# 12-byte record, so the input is exactly D082's 1 MiB maximum. Leading
# whitespace exercises a single long-lived decoder frame, not many short calls.
string(REPEAT " " 1048564 padding)
file(WRITE "${root}/valid.json" "${padding}{\"value\":42}")
file(WRITE "${root}/over.json" "${padding}{\"value\":42} ")
file(WRITE "${root}/invalid.json" "${padding}{\"value\":4!}")
file(SIZE "${root}/valid.json" input_size)
if(NOT input_size EQUAL 1048576)
  message(FATAL_ERROR "local execution fixture has wrong size: ${input_size}")
endif()

foreach(engine IN ITEMS vm debug release)
  if(engine STREQUAL "vm")
    set(command "${MMAY_TEST_TOOL}" run "${MMAY_TEST_SOURCE}" --)
  else()
    set(flags)
    if(engine STREQUAL "release")
      list(APPEND flags --release)
    endif()
    succeeds(build "${MMAY_TEST_TOOL}" build "${MMAY_TEST_SOURCE}"
      ${flags} --output "${root}/${engine}")
    set(command "${root}/${engine}")
  endif()
  succeeds(loop ${command} loop)
  if(NOT observed_loop STREQUAL "10000001\n")
    message(FATAL_ERROR "local execution loop ${engine}: ${observed_loop}")
  endif()
  foreach(case IN ITEMS valid over invalid json-over)
    set(input "${root}/${case}.json")
    set(arguments)
    if(case STREQUAL "json-over")
      set(input "${root}/valid.json")
      set(arguments json-over)
    endif()
    execute_process(COMMAND ${command} ${arguments} INPUT_FILE "${input}"
      RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error
      TIMEOUT 180)
    if(engine STREQUAL "vm")
      if(case STREQUAL "valid")
        if(NOT status EQUAL 0 OR NOT output STREQUAL "{\"value\":42}"
            OR NOT error STREQUAL "")
          message(FATAL_ERROR "local execution valid: ${status}/${output}/${error}")
        endif()
      elseif(NOT status EQUAL 1 OR NOT output STREQUAL "" OR error STREQUAL "")
        message(FATAL_ERROR "local execution ${case}: ${status}/${output}/${error}")
      endif()
      if(case STREQUAL "json-over" AND NOT error MATCHES "input bytes")
        message(FATAL_ERROR "local execution lost JSON limit: ${error}")
      endif()
      if(case STREQUAL "over" AND NOT error MATCHES "standard input exceeds")
        message(FATAL_ERROR "local execution lost stdin limit: ${error}")
      endif()
      set("vm_${case}_status" "${status}")
      set("vm_${case}_output" "${output}")
      set("vm_${case}_error" "${error}")
    elseif(NOT status STREQUAL vm_${case}_status
        OR NOT output STREQUAL vm_${case}_output
        OR NOT error STREQUAL vm_${case}_error)
      message(FATAL_ERROR "local execution ${engine}/${case} differs: ${status}/${output}/${error}")
    endif()
  endforeach()
endforeach()
