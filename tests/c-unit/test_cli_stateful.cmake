file(MAKE_DIRECTORY "${MMAY_TEST_WORK}")
function(require_ok)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL 0 OR NOT err STREQUAL "")
    message(FATAL_ERROR "command ${ARGV}: status=${status}; stdout=${out}; stderr=${err}")
  endif()
endfunction()
require_ok("${MMAY_TEST_TOOL}" fmt "${MMAY_TEST_SOURCE}" --check)
require_ok("${MMAY_TEST_TOOL}" test "${MMAY_TEST_SOURCE}" --engine both)
get_filename_component(app "${MMAY_TEST_SOURCE}" NAME)
if(app STREQUAL "cli-delimited")
  set(arguments csv-to-json -)
else()
  set(arguments --json -)
endif()
file(READ "${MMAY_TEST_SOURCE}/expected.json" expected)
function(require_output)
  execute_process(COMMAND ${ARGV} INPUT_FILE "${MMAY_TEST_SOURCE}/input.txt"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL 0 OR NOT out STREQUAL expected OR NOT err STREQUAL "")
    message(FATAL_ERROR "${ARGV}: status=${status}; stdout=${out}; stderr=${err}; expected=${expected}")
  endif()
endfunction()
require_output("${MMAY_TEST_TOOL}" run "${MMAY_TEST_SOURCE}" -- ${arguments})
foreach(profile IN ITEMS debug release)
  set(flags)
  if(profile STREQUAL "release")
    set(flags --release)
  endif()
  set(binary "${MMAY_TEST_WORK}/${profile}${MMAY_TEST_SUFFIX}")
  require_ok("${MMAY_TEST_TOOL}" build "${MMAY_TEST_SOURCE}" ${flags} --output "${binary}")
  require_output("${binary}" ${arguments})
endforeach()
