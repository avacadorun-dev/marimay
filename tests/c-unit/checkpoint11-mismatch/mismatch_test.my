import { println } from "std/io";

@test
fn exactMismatch(): void {
  expect.output("expected\n", (): void => {
    const _ = println("actual");
  });
}

@test
fn explicitPanicParity(): void {
  panic("boom");
}

@test
fn valueExpectationParity(): void {
  expect.equal("left", "right");
}

@test
fn cleanupExpectation(): void {
  expect.output("", (): void => {});
}

@test
fn mismatchSurvivesCleanupExpectation(): void {
  defer cleanupExpectation();
  expect.output("kept", (): void => {});
}
