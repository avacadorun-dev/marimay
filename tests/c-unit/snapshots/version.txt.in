Marimay compiler @MMAY_COMPILER_VERSION@
release-channel @MMAY_RELEASE_CHANNEL@
release-claim @MMAY_RELEASE_CLAIM@
publication-ready @MMAY_RELEASE_PUBLICATION_READY_JSON@
runtime @MMAY_RUNTIME_VERSION@
language @MMAY_LANGUAGE_VERSION@
bytecode @MMAY_BYTECODE_VERSION@ (@MMAY_BYTECODE_COMPATIBILITY@)
standard-library @MMAY_STANDARD_LIBRARY_VERSION@ (@MMAY_STANDARD_LIBRARY_SCOPE@; @MMAY_STANDARD_LIBRARY_COMPATIBILITY@)
bootstrap-stage @MMAY_BOOTSTRAP_STAGE@
host @CMAKE_SYSTEM_NAME@/@CMAKE_SYSTEM_PROCESSOR@
targets native-host
available-commands build check doctor fmt help init run test version
staged-commands add audit bench doc exec explain fix fuzz generate list outdated remove update vendor vet why
