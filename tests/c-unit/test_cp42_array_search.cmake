cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED MMAY_TEST_TOOL OR NOT DEFINED MMAY_TEST_SOURCE OR NOT DEFINED MMAY_TEST_WORK)
  message(FATAL_ERROR "Array-search test variables are missing")
endif()
file(REMOVE_RECURSE "${MMAY_TEST_WORK}")
file(MAKE_DIRECTORY "${MMAY_TEST_WORK}")
file(COPY "${MMAY_TEST_SOURCE}/" DESTINATION "${MMAY_TEST_WORK}/source" PATTERN ".mmay" EXCLUDE)
set(source "${MMAY_TEST_WORK}/source")
include("${CMAKE_CURRENT_LIST_DIR}/test_cp42_warning_support.cmake")
cp42_warning_baseline("${source}" 0 5)
function(search_expect expected_status expected_error)
  cp42_warning_prefix(prefix ${ARGN})
  set(expected_error "${prefix}${expected_error}")
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180)
  if(NOT status STREQUAL "${expected_status}" OR NOT error STREQUAL "${expected_error}")
    message(FATAL_ERROR "Array search: ${ARGN}: status=${status}; stdout=${output}; stderr=${error}")
  endif()
  set(search_output "${output}" PARENT_SCOPE)
endfunction()
search_expect(0 "" "${MMAY_TEST_TOOL}" fmt "${source}" --check)
search_expect(0 "" "${MMAY_TEST_TOOL}" check "${source}")
search_expect(0 "" "${MMAY_TEST_TOOL}" test "${source}" --engine both)
if(NOT search_output MATCHES "10 passed; 0 failed")
  message(FATAL_ERROR "Array search tests: ${search_output}")
endif()
foreach(engine vm debug release)
  if(engine STREQUAL "vm")
    set(command "${MMAY_TEST_TOOL}" run "${source}" --)
  else()
    set(flags)
    if(engine STREQUAL "release")
      set(flags --release)
    endif()
    set(binary "${MMAY_TEST_WORK}/array-search-${engine}${MMAY_TEST_SUFFIX}")
    search_expect(0 "" "${MMAY_TEST_TOOL}" build "${source}" ${flags} --output "${binary}")
    set(command "${binary}")
  endif()
  search_expect(0 "" ${command})
  if(NOT search_output STREQUAL "")
    message(FATAL_ERROR "Unexpected normal search output: ${search_output}")
  endif()
  foreach(mode true false last-false set clear push deferred nested panic)
    set(panic "panic[G4005]: array iterator invalidated by mutation\n")
    if(mode STREQUAL "panic")
      set(panic "panic[G4000]: predicate panic\n")
    endif()
    search_expect(1 "search cleanup\n${panic}" ${command} "${mode}")
    if(NOT search_output STREQUAL "")
      message(FATAL_ERROR "Unexpected search panic output: ${search_output}")
    endif()
  endforeach()
endforeach()
