# Compiler-warning expectations are independent from runtime stderr. Counts are
# fixed by each fixture; JSON locks code/severity and every command must reproduce
# the same complete human diagnostics as check of the corresponding target set.
function(cp42_warning_baseline source expected_main expected_all)
  foreach(mode main all)
    set(flags)
    if(mode STREQUAL "all")
      set(flags --all-targets)
    endif()
    execute_process(COMMAND "${MMAY_TEST_TOOL}" check "${source}" ${flags} --diagnostic json
      RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 120)
    if(NOT status STREQUAL "0" OR NOT output STREQUAL "")
      message(FATAL_ERROR "Warning baseline check failed: ${status}; ${output}; ${diagnostics}")
    endif()
    string(REPLACE "\n" ";" lines "${diagnostics}")
    set(count 0)
    foreach(line IN LISTS lines)
      if(line STREQUAL "")
        continue()
      endif()
      string(JSON code GET "${line}" code)
      string(JSON severity GET "${line}" severity)
      if(NOT code STREQUAL "T0020" OR NOT severity STREQUAL "warning")
        message(FATAL_ERROR "Unexpected compiler diagnostic: ${line}")
      endif()
      math(EXPR count "${count} + 1")
    endforeach()
    if(NOT count EQUAL expected_${mode})
      message(FATAL_ERROR "Expected ${expected_${mode}} ${mode} warnings, got ${count}: ${diagnostics}")
    endif()
    execute_process(COMMAND "${MMAY_TEST_TOOL}" check "${source}" ${flags}
      RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE warnings TIMEOUT 120)
    if(NOT status STREQUAL "0" OR NOT output STREQUAL "")
      message(FATAL_ERROR "Human warning check failed: ${status}; ${output}; ${warnings}")
    endif()
    set(warnings_${mode} "${warnings}" PARENT_SCOPE)
  endforeach()
endfunction()

function(cp42_warning_prefix result)
  set(args ${ARGN})
  list(GET args 0 executable)
  set(prefix "")
  if(executable STREQUAL MMAY_TEST_TOOL)
    list(GET args 1 command)
    if(command STREQUAL "test" OR "--all-targets" IN_LIST args)
      set(prefix "${warnings_all}")
    elseif(command MATCHES "^(check|run|build)$")
      set(prefix "${warnings_main}")
    endif()
  endif()
  set(${result} "${prefix}" PARENT_SCOPE)
endfunction()
