if(NOT DEFINED MMAY_TEST_TOOL OR NOT DEFINED MMAY_TEST_WORK)
  message(FATAL_ERROR "CP42 location variables are missing")
endif()
set(root "${MMAY_TEST_WORK}/Мир с пробелом")
file(MAKE_DIRECTORY "${root}")
file(WRITE "${root}/mmay.mod" "module \"tests.cp42.locations\"\nlanguage \"0.1\"\n")
string(ASCII 239 187 191 bom)
string(ASCII 13 cr)
set(helper "${bom}// UTF-8 🙂${cr}\nimport * as io from \"std/io\";${cr}\nfn same<T>(value: T, other: T): void {${cr}\n  const _ = io.eprintln(\"до ошибки\");${cr}\n  const label = \"Я🙂\"; expect.equal(value, other);${cr}\n}${cr}\n")
file(WRITE "${root}/помощник_test.my" "${helper}")
file(SHA256 "${root}/помощник_test.my" original_hash)
file(WRITE "${root}/main_test.my"
  "@test fn integerFailure(): void { same(1, 2); }\n@test fn stringFailure(): void { same(\"а\", \"б\"); }\n@test fn continues(): void { expect.true(true); }\n")
set(location "  --> ${root}/помощник_test.my:5:23-5:49\n")
set(failure "  stderr:\nдо ошибки\npanic[G4004]: expect.equal failed: values differ at root\n${location}")
set(expected "test tests.cp42.locations.integerFailure ... FAILED\n${failure}test tests.cp42.locations.stringFailure ... FAILED\n${failure}test tests.cp42.locations.continues ... ok\ntest result: FAILED. 1 passed; 2 failed\n")
foreach(engine IN ITEMS vm native both)
  execute_process(COMMAND "${MMAY_TEST_TOOL}" test "${root}" --engine "${engine}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180)
  if(NOT status EQUAL 1 OR NOT error STREQUAL "" OR NOT output STREQUAL expected)
    message(FATAL_ERROR "CP42 location ${engine}: ${status}/${output}/${error}; expected ${expected}")
  endif()
endforeach()
# The normal test command must not rewrite the immutable input snapshots.
file(SHA256 "${root}/помощник_test.my" observed_hash)
if(NOT observed_hash STREQUAL original_hash)
  message(FATAL_ERROR "CP42 location checking rewrote BOM/CRLF source")
endif()
