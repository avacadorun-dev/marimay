if(NOT DEFINED MMAY_TEST_TOOL OR NOT DEFINED MMAY_TEST_SOURCE OR NOT DEFINED MMAY_TEST_WORK)
  message(FATAL_ERROR "Mapper-value variables are missing")
endif()
file(REMOVE_RECURSE "${MMAY_TEST_WORK}")
file(MAKE_DIRECTORY "${MMAY_TEST_WORK}")
file(COPY "${MMAY_TEST_SOURCE}/" DESTINATION "${MMAY_TEST_WORK}/source" PATTERN ".mmay" EXCLUDE)
set(source "${MMAY_TEST_WORK}/source")
function(mapper_expect status_expected error_expected)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180)
  if(NOT status STREQUAL "${status_expected}" OR NOT error STREQUAL "${error_expected}")
    message(FATAL_ERROR "Mapper values: ${ARGN}: ${status}; ${output}; ${error}")
  endif()
  set(mapper_output "${output}" PARENT_SCOPE)
endfunction()
function(mapper_run status_expected error_expected)
  mapper_expect("${status_expected}" "${error_expected}" ${ARGN})
  if(NOT mapper_output STREQUAL "")
    message(FATAL_ERROR "Unexpected mapper stdout: ${mapper_output}")
  endif()
endfunction()
mapper_expect(0 "" "${MMAY_TEST_TOOL}" fmt "${source}" --check)
mapper_expect(0 "" "${MMAY_TEST_TOOL}" check "${source}" --all-targets)
mapper_expect(0 "" "${MMAY_TEST_TOOL}" test "${source}" --engine both)
if(NOT mapper_output MATCHES "10 passed; 0 failed")
  message(FATAL_ERROR "Mapper tests did not run: ${mapper_output}")
endif()
foreach(engine vm debug release)
  if(engine STREQUAL "vm")
    set(command "${MMAY_TEST_TOOL}" run "${source}" --)
  else()
    set(flags)
    if(engine STREQUAL "release")
      set(flags --release)
    endif()
    set(binary "${MMAY_TEST_WORK}/mapper-${engine}${MMAY_TEST_SUFFIX}")
    mapper_expect(0 "" "${MMAY_TEST_TOOL}" build "${source}" ${flags} --output "${binary}")
    set(command "${binary}")
  endif()
  mapper_run(0 "" ${command})
  mapper_run(0 "caller cleanup\n" ${command} ok)
  mapper_run(1 "callback cleanup\ncaller cleanup\npanic[G4000]: mapper panic\n" ${command} bad)
  mapper_run(1 "caller cleanup\npanic[G4000]: factory panic\n" ${command} factory)
  mapper_run(1 "caller cleanup\npanic[G4000]: factory panic\n" ${command} factory-ok)
endforeach()

file(WRITE "${source}/failure_test.my"
  "@test\nfn contextualFailure(): void {\n  const source: Result<int, int> = Err(1);\n  const _: Result<int, void> = source.mapError((error) => expect.equal(error, 2));\n}\n")
foreach(engine vm native both)
  execute_process(COMMAND "${MMAY_TEST_TOOL}" test "${source}" --engine "${engine}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180)
  if(NOT status STREQUAL "1" OR NOT output MATCHES "10 passed; 1 failed"
      OR NOT output MATCHES "failure_test.my:4:59-4:81" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Contextual mapper location ${engine}: ${status}; ${output}; ${error}")
  endif()
endforeach()
