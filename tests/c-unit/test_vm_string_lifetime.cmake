file(MAKE_DIRECTORY "${MMAY_TEST_WORK}")
function(require_ok)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL 0 OR NOT err STREQUAL "")
    message(FATAL_ERROR "${ARGV}: status=${status}; stdout=${out}; stderr=${err}")
  endif()
endfunction()
function(require_report)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL 0 OR NOT out STREQUAL "report-concat 762303259\n" OR NOT err STREQUAL "")
    message(FATAL_ERROR "${ARGV}: status=${status}; stdout=${out}; stderr=${err}")
  endif()
endfunction()
function(require_budget_failure)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL 70 OR NOT out STREQUAL "" OR NOT err MATCHES "error\\[I0002\\]: managed heap budget exceeded: live=[0-9]+ bytes, requested=[0-9]+ bytes, limit=65536 bytes")
    message(FATAL_ERROR "${ARGV}: status=${status}; stdout=${out}; stderr=${err}")
  endif()
endfunction()
require_ok("${MMAY_TEST_TOOL}" fmt "${MMAY_TEST_SOURCE}" --check)
require_ok("${MMAY_TEST_TOOL}" test "${MMAY_TEST_SOURCE}" --engine both --max-heap-bytes 8388608)
foreach(budget IN ITEMS 67108864 268435456)
  require_report("${MMAY_TEST_TOOL}" run "${MMAY_TEST_SOURCE}" --engine vm --max-heap-bytes "${budget}")
endforeach()
require_budget_failure("${MMAY_TEST_TOOL}" run "${MMAY_TEST_SOURCE}" --engine vm --max-heap-bytes 65536)
foreach(profile IN ITEMS debug release)
  set(flags)
  if(profile STREQUAL "release")
    set(flags --release)
  endif()
  set(binary "${MMAY_TEST_WORK}/${profile}${MMAY_TEST_SUFFIX}")
  require_ok("${MMAY_TEST_TOOL}" build "${MMAY_TEST_SOURCE}" ${flags} --output "${binary}" --max-heap-bytes 67108864)
  require_report("${binary}")
  set(limited "${MMAY_TEST_WORK}/${profile}-limited${MMAY_TEST_SUFFIX}")
  require_ok("${MMAY_TEST_TOOL}" build "${MMAY_TEST_SOURCE}" ${flags} --output "${limited}" --max-heap-bytes 65536)
  require_budget_failure("${limited}")
endforeach()
