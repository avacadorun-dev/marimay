if(NOT DEFINED MMAY_TEST_TOOL OR NOT DEFINED MMAY_TEST_SOURCE OR NOT DEFINED MMAY_TEST_WORK)
  message(FATAL_ERROR "Option-binding test variables are missing")
endif()

# This owner uses a fresh, disposable source tree; failed runs retain diagnostics.
file(REMOVE_RECURSE "${MMAY_TEST_WORK}")
file(MAKE_DIRECTORY "${MMAY_TEST_WORK}")
file(COPY "${MMAY_TEST_SOURCE}/" DESTINATION "${MMAY_TEST_WORK}/source" PATTERN ".mmay" EXCLUDE)
set(source "${MMAY_TEST_WORK}/source")

function(option_expect status_expected error_expected)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
  if(NOT status STREQUAL "${status_expected}" OR NOT error STREQUAL "${error_expected}")
    message(FATAL_ERROR "Option binding: ${ARGN}: status=${status}; stdout=${output}; stderr=${error}")
  endif()
  set(option_output "${output}" PARENT_SCOPE)
endfunction()

option_expect(0 "" "${MMAY_TEST_TOOL}" fmt "${source}" --check)
option_expect(0 "" "${MMAY_TEST_TOOL}" check "${source}")
option_expect(0 "" "${MMAY_TEST_TOOL}" test "${source}" --engine both)
if(NOT option_output MATCHES "9 passed; 0 failed")
  message(FATAL_ERROR "Option binding tests did not all pass: ${option_output}")
endif()
option_expect(0 "" "${MMAY_TEST_TOOL}" run "${source}")
if(NOT option_output STREQUAL "")
  message(FATAL_ERROR "Option binding normal VM output: ${option_output}")
endif()
set(panic "option cleanup 7\npanic[G4000]: option panic\n")
option_expect(1 "${panic}" "${MMAY_TEST_TOOL}" run "${source}" -- panic)
if(NOT option_output STREQUAL "")
  message(FATAL_ERROR "Option binding panic VM stdout: ${option_output}")
endif()
foreach(profile debug release)
  set(flags)
  if(profile STREQUAL "release")
    set(flags --release)
  endif()
  set(binary "${MMAY_TEST_WORK}/option-${profile}${MMAY_TEST_SUFFIX}")
  option_expect(0 "" "${MMAY_TEST_TOOL}" build "${source}" ${flags} --output "${binary}")
  option_expect(0 "" "${binary}")
  if(NOT option_output STREQUAL "")
    message(FATAL_ERROR "Option binding normal ${profile} output: ${option_output}")
  endif()
  option_expect(1 "${panic}" "${binary}" panic)
  if(NOT option_output STREQUAL "")
    message(FATAL_ERROR "Option binding panic ${profile} stdout: ${option_output}")
  endif()
endforeach()
